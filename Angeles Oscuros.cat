    <profile id="2c18-4320-bb63-83be" name="Veterano" publicationId="822e-763d-4a6a-b7fc" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
