      </characteristics>
    </profile>
    <profile id="fb80-c076-7c33-8a76" name="Bendición del Omnissiah" publicationId="822e-763d-4a6a-b7fc" page="31" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si durante la fase de disparo un Tecnomarine está en contacto peana con peana con un vehiculo dañado, puede intentar repararlo en lugar de disparar. Tira 1D6 y suma los modificadores siguientes:

Por cada Servidor con un servobrazo en la unidad +1

Si el resultado es 6+, un resultado de arma destruida o de inmovilizado (elige el propio jugador) será reparado. Si un resultado de arma destruida consigue repararse mediante este método, el arma podrá dispararse en la siguiente fase de disparo. El Tecnomarine no podrá reparar si está ¡Cuerpo a tierra! o en ¡Retirada!</characteristic>
      </characteristics>
    </profile>
    <profile id="90a7-c0e2-3a06-dc70" name="Bolter" publicationId="822e-763d-4a6a-b7fc" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" page="48">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Fuego Rápido</characteristic>
      </characteristics>
    </profile>
    <profile id="d495-caf7-3c41-4620" name="Bolter de Asalto" publicationId="822e-763d-4a6a-b7fc" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" page="52">
