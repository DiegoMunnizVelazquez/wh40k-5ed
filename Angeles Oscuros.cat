    <infoGroup id="bd2d-d88a-cac3-8257" name="Armas Reliquia" hidden="false">
      <profiles>
        <profile id="dbce-101a-ba8e-665e" name="Armas Reliquia" publicationId="f176-f140-74d8-da7d" page="97" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un arma reliquia se considera un arma de energia, pero sus impactos se resuelven con Fuerza 6. A causa de su tamaño y peso, una miniatura equipada con un arma reliquia no puede conseguir ataques extras por estar equipada con un arma de combate cuerpo a cuerpo adicional.</characteristic>
          </characteristics>
        </profile>
      </profiles>
