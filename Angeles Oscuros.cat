        <selectionEntry type="upgrade" import="true" name="Estandarte de Compañía del Ala de Muerte" hidden="true" id="a3b1-e5b9-67dc-cb46" sortIndex="2">
          <costs>
            <cost name="Pts" typeId="puntos" value="25"/>
          </costs>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="369b-4ec4-ee78-a306" includeChildSelections="true" includeChildForces="true"/>
          </constraints>
          <profiles>
            <profile name="Estandarte del Ala de Cuervo" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="54c0-dbc8-500f-2bd2" publicationId="822e-763d-4a6a-b7fc" page="45">
              <characteristics>
                <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si Sammael está presente en la batalla, uno de los integrantes de un escuadrón de ataque del Ala de Cuervo que conduzca una motocicleta podrá llevar uno de los estandartes de la compañía del Ala de Cuervo. Toda unidad de Ángeles Oscuros con al menos una miniatura en un radio de 30 cm del estandarte puede repetir los chequeos de moral y de acobardamiento fallados. Además, todas las miniaturas de la unidad del portaestandarte tendrán un modificador de +1 a su atributo de Ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <modifiers>
            <modifier type="set" value="false" field="hidden">
              <conditions>
                <condition type="atLeast" value="1" field="selections" scope="roster" childId="9733-b64b-888c-319f" shared="true" includeChildSelections="true" includeChildForces="true"/>
              </conditions>
            </modifier>
          </modifiers>
        </selectionEntry>
      </selectionEntries>
      <entryLinks>
        <entryLink id="14e4-42bb-8a42-cb58" name="Motocicleta de Ataque" hidden="false" collective="false" import="true" targetId="6e28-fdc2-e879-9ead" type="selectionEntry" sortIndex="4">
          <constraints>
