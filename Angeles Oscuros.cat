              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Compañía del Ala de Muerte" id="a3b1-e5b9-67dc-cb46" hidden="true" import="true" sortIndex="2" type="upgrade">
          <constraints>
            <constraint id="369b-4ec4-ee78-a306" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
