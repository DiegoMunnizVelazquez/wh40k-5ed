            </modifier>
          </modifiers>
          <profiles>
            <profile name="Estandarte del Ala de Cuervo" id="5843-c597-f298-0b0d" hidden="false" page="45" publicationId="822e-763d-4a6a-b7fc" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si Sammael está presente en la batalla, uno de los integrantes de un escuadrón de ataque del Ala de Cuervo que conduzca una motocicleta podrá llevar uno de los estandartes de la compañía del Ala de Cuervo. Toda unidad de Ángeles Oscuros con al menos una miniatura en un radio de 30 cm del estandarte puede repetir los chequeos de moral y de acobardamiento fallados. Además, todas las miniaturas de la unidad del portaestandarte tendrán un modificador de +1 a su atributo de Ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
