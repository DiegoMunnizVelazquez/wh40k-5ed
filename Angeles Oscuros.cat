    <infoGroup name="Armas Reliquia" id="bd2d-d88a-cac3-8257" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="b0a6-d967-b1bd-aba2" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Armas Reliquia" id="dbce-101a-ba8e-665e" hidden="false" page="97" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un arma reliquia se considera un arma de energia, pero sus impactos se resuelven con Fuerza 6. A causa de su tamaño y peso, una miniatura equipada con un arma reliquia no puede conseguir ataques extras por estar equipada con un arma de combate cuerpo a cuerpo adicional.</characteristic>
          </characteristics>
        </profile>
