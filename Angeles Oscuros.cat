    <profile name="Motocicleta de Ataque" id="2ecf-8d26-a519-09f6" hidden="false" publicationId="822e-763d-4a6a-b7fc" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
