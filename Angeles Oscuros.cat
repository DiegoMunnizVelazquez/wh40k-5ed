          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Un Bibliotecario Ángel Oscuro tiene dos poderes psíquicos (Escudo de Energía y Fuego Infernal). Solo puede usar un poder en cada turno del jugador. Todos los poderes psíquicos de los Bibliotecarios de los Ángeles Oscuros están sujetos a las reglas descritas en el reglamento de Warhammer 40,000.</characteristic>
          </characteristics>
        </profile>
        <profile id="9471-392a-9c01-8487" name="Bibliotecario" publicationId="822e-763d-4a6a-b7fc" page="38" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
