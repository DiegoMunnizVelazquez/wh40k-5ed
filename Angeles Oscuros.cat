    <profile id="196e-b41a-0c94-8c21" name="Dreadnought" publicationId="822e-763d-4a6a-b7fc" page="30" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Bípode">
      <characteristics>
        <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic>
