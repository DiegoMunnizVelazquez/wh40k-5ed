      <profiles>
        <profile name="¡Mira alli!" id="8067-ffe7-21d2-9def" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">En su fase de disparo, antes de realizar su segundo ataque a distancia, tira un dado. Con un resultado de 4 - 6, procede como es habitual. Con un resultado de 1 - 3, utilizarán nuevamente el poder que acaban de utilizar.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Furia del Caos" id="78175857-3a67-481e-af43-de41fabbcbc7" hidden="false" import="true" type="model">
