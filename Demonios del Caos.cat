      <profiles>
        <profile name="Aura de sometimiento" id="6535-d8f7-a46d-2110" hidden="false" page="75" publicationId="7e39-7527-c129-cdf4" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Las miniaturas con este regalo se consideran equipadas con granadas defensivas y de asalto (pero no reciben el bonificador a la Fuerza al atacar vehículos en cuerpo a cuerpo).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Garras aceradas" id="2845-0c90-bcce-da10" hidden="false">
      <infoLinks>
        <infoLink name="Acerada" id="ce5b-f307-1c4e-4225" hidden="false" targetId="7097-6879-0d11-787d" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Garras aceradas" id="d433-4cb7-a046-4967" hidden="false" page="73" publicationId="7e39-7527-c129-cdf4" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Las garras aceradas son un par de armas aceradas de combate cuerpo a cuerpo, como se describen en el reglamento de Warhammer 40,000 (el modificador siempre está incluido en el perfil del demonio).</characteristic>
          </characteristics>
        </profile>
      </profiles>
