          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A la hora de disparar, el Aplastador elegirá con que perfil de las fauces quiere disparar, Vómito, Lengua o Flema.
Cuando un resultado de armamento destruido destruye las fauces del caos, se destruyen todos los perfiles.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Demonio" id="bfae-d92a-8da4-5595" hidden="false">
          <description>El Aplastador se despliega como el resto de demonios y es inmune a los efectos de tripulación aturdida y acobardada</description>
        </rule>
      </rules>
