      </characteristics>
    </profile>
    <profile name="Vórtice espiritual" id="fafac5d2-0c0d-4749-8ebd-af60c099d326" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45cm</characteristic>
