            <infoLink name="Espiral de sombras" id="e10a-2e71-b092-b5d1" hidden="false" targetId="8cf6-1a29-85ea-2b45" type="profile"/>
            <infoLink name="Granadas de disrupción" id="73d3-8e2a-a245-5e86" hidden="false" targetId="bfed-c438-e1b1-adef" type="profile"/>
            <infoLink name="Orbes de obsidiana" id="df3a-0c26-98c1-51c5" hidden="false" targetId="91aa190b-463a-43ba-a46a-ae371be6d254" type="profile"/>
            <infoLink name="Orbes de obsidiana" id="d6ba-723f-322f-4616" hidden="false" targetId="fc11-cc75-1a22-e3dd" type="profile"/>
            <infoLink name="Pistola cristalina" id="4e69-0857-c0d6-f186" hidden="false" targetId="c9ac8316-149d-4a0a-9baa-81b4c060de2e" type="profile"/>
            <infoLink name="Coraje" id="1560-b2f2-6fc3-76eb" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
