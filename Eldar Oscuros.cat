    <selectionEntry name="Urien Rakarth" id="310f0232-2229-4d3a-991e-e0e1335f2608" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="703d-aeea-8de5-e188" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="190"/>
      </costs>
      <infoLinks>
        <infoLink name="Urien Rakarth" id="adc5-d1fd-3a17-4a31" hidden="false" targetId="da8cb6b5-d60d-4d19-8b2a-f6117da9e5c8" type="profile"/>
        <infoLink name="Imagen clónica" id="e5d4-607d-44cc-d414" hidden="false" targetId="1649-5424-f34e-2de4" type="profile"/>
        <infoLink name="Cofre desollador" id="3ede-76ee-0a6c-8263" hidden="false" targetId="98ee4487-2765-4997-9a6b-b16cfaa8a1ee" type="profile"/>
        <infoLink name="Brazal quirúrgico" id="92f7-826b-d1b0-c814" hidden="false" targetId="3ae6-ac4a-480b-e22b" type="profile"/>
        <infoLink name="Personaje independiente" id="bf1e-15b5-7f2f-320d" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Guante de icor" id="0c76-63d5-56cf-aa80" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Rakarth puede inyectar a sus victimas un icor ardiente. El guante funciona igual que un brazal quirúrgico, y además es un arma envenenada (3+).</characteristic>
          </characteristics>
        </profile>
        <profile name="Recomponer la carne" id="cab8-9a93-d1fb-4f5c" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Rakarth se cura automáticamente una única herida al principio de cada uno de sus turnos, su cuerpo cosiéndose por si solo. No puede exceder su valor original.</characteristic>
          </characteristics>
        </profile>
        <profile name="Padre del dolor" id="804a-15ab-1b2e-ecc3" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Urien empieza la partida con un marcador de dolor. Además para representar el talento de Rakarth con la carne, elige 1D3 unidades al principio de la partida (deben ser unidades de Grotescos o de Atormentados). Cada una de estas unidades obtiene un marcador de dolor.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
