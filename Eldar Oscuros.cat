    <selectionEntry name="Barón Sathonyx" id="f4357f4f-179c-4cbd-8866-3c9c1a515645" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="4b69-774b-4a62-e442" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="105"/>
      </costs>
      <infoLinks>
        <infoLink name="Barón Sathonyx" id="a597-1fa5-1956-7e4f" hidden="false" targetId="32142d9e-ccb6-4cf1-a953-c968effde1bf" type="profile"/>
        <infoLink name="Espiral de sombras" id="18d7-0ede-c6dc-7816" hidden="false" targetId="8cf6-1a29-85ea-2b45" type="profile"/>
        <infoLink name="Pistola cristalina" id="c108-2fca-38b1-4cd9" hidden="false" targetId="c9ac8316-149d-4a0a-9baa-81b4c060de2e" type="profile"/>
        <infoLink name="Espadón infernal" id="0c89-dc05-3c1b-bb4c" hidden="false" targetId="aff4-9ad8-8aa7-e771" type="profile"/>
        <infoLink name="Unidad retropropulsada" id="f39f-5806-75a0-09d8" hidden="false" targetId="d6f4-cfda-75c5-f2f1" type="rule"/>
        <infoLink name="Atacar y Huir" id="a18f-8f20-e078-991a" hidden="false" targetId="e664-80ee-cd50-fd59" type="rule"/>
        <infoLink name="Personaje independiente" id="a413-e200-b76a-09fd" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink name="Sigilo" id="cbc2-a0ed-26a5-6abf" hidden="false" targetId="f1ee-e19a-a3c3-6797" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Aeropatín personalizado" id="0580-2023-7669-1d22" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El aeropatin personalizado de Sathonyx se considera un aeropatin normal (ver página 28). Además añade un +2 a la Fuerza de sus ataques en cualquier turno en el que asalte.</characteristic>
          </characteristics>
        </profile>
        <profile name="Huesos del Vidente" id="6678-7542-d71a-d5d9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Para representar las &quot;intuiciones&quot; del Barón, cualquier ejercito que incluya a Sathonyx sumará uno al dado en la tirada para determinar qué bando elige la zona de despliegue.</characteristic>
          </characteristics>
        </profile>
        <profile name="Generador de tinieblas" id="f663-d446-f5a5-0580" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El Aeropatin de Sathonyx incorpora un sofisticado artilugio que atrae la oscuridad. La capa de tinieblas le otorga a Sathonyx y a su unidad la regla Sigilo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Maestro de los cielos" id="96f5-3ff2-2d4e-685f" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Sathonyx y cualquier unidad de Infernales a la que se una podrá repetir las tiradas fallidas de terreno peligroso. Además, cuando utilicen su regla Atacar y huir, podrán repetir tanto el chequeo de Iniciativa como la tirada para determinar la distancia que pueden mover.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
