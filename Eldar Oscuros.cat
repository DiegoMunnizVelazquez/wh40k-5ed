      </infoLinks>
    </infoGroup>
    <infoGroup name="Agonizador" id="8f6f-a65f-964a-4eef" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="3c90-4a13-099b-2c6c" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
        <infoLink name="Envenenada" id="9c0b-b64e-78bd-eef2" hidden="false" targetId="48c8-bb35-6595-03d1" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Agonizador" id="fbc8-5e24-a9c1-6917" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Los Agonizadores son armas de energía que hieren siempre con una tirada de 4+, independientemente de la Resistencia del enemigo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Brazales hidra" id="5303-a439-108e-0001" hidden="false">
      <profiles>
        <profile name="Brazales hidra" id="6314-1f9f-9b4c-2fc0" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Cuentan como dos armas de combate cuerpo a cuerpo; no obstante, en vez de proporcionar +1 ataque adicional, confieren +1D6 ataques adicionales. Tira al principio de cada rondade combate para determinar el número de ataques adicionales.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Brazal de trance" id="a205-6681-edcd-e1c3" hidden="false">
      <profiles>
        <profile name="Brazal de trance" id="cd8d-91ff-e075-66e4" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El brazal de trance es un arma especial de combate cuerpo a cuerpo. Un Personaje independiente o Criatura monstruosa que haya sido impactado por un brazal de trance deberá superar un chequeo de Fuerza y uno de Liderazgo por cada impacto sufrido. Si falla alguno de dichos chequeos, la miniatura ha sucumbido al brazal de trance y no podrá realizar más ataques en esa fase de asalto.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Filored y empalador" id="456e-0ef6-a929-5308" hidden="false">
      <profiles>
        <profile name="Filored y empalador" id="a8dd-3510-a476-fb9c" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Un juego de filored y empalador cuenta como dos armas de combate cuerpo a cuerpo. Además, para representar los efectos inmovilizantes de la filored, toda miniatura enemiga en contacto peana con peana con el portador combatirá con un Ataque menos (hasta un mínimo de 1).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Flagelos encadenados" id="bf9b-c6d7-d578-0791" hidden="false">
      <profiles>
        <profile name="Flagelos encadenados" id="3f8c-69b1-367d-0319" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Los flagelos encadenados cuentan como dos armas de combate cuerpo a cuerpo. Para representar el hecho de que los flagelos son virtualmente imposibles de bloquear o esquivar, el portador puede repetir los chequeos para impactar y para herir en cuerpo a cuerpo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Espada fantasma" id="33c0-a14e-3f8f-96f1" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="24c8-6d75-9239-14ec" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Espada fantasma" id="38ca-618e-62a6-7416" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">La espada fantasma es un arma de energía. Además, su portador hará dos ataques adicionales en cada ronda de combate cuerpo a cuerpo. Haz estas tiradas por separado. Si se obtiene una tirada doble en cualquiera de las tiradas para impactar de estos dos ataques, la espada se rebela contra su portador. Los dos ataques impactan automáticamente al portador.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Espada venenosa" id="9230-5f1e-cb3b-7fd0" hidden="false">
      <infoLinks>
        <infoLink name="Envenenada" id="0423-21e1-da04-efd0" hidden="false" targetId="48c8-bb35-6595-03d1" type="rule"/>
        <infoLink name="Espada venenosa" id="ad0d-52b6-b2b9-2f18" hidden="false" targetId="c2bf-3e6f-5463-35ba" type="profile"/>
      </infoLinks>
    </infoGroup>
    <infoGroup name="Espadón infernal" id="6871-685e-b30b-770a" hidden="false">
      <modifiers>
        <modifier affects="profiles.Unidad" field="5dff3e7c-e024-4030-a71d-03195ec06ea7" scope="parent" type="increment" value="1"/>
        <modifier affects="profiles.Unidad" field="da036dbb-32c2-430a-9dd5-aa74e0c4f74b" scope="parent" type="increment" value="1"/>
      </modifiers>
      <profiles>
        <profile name="Espadón infernal" id="f8b6-de18-4ed8-a0b3" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El espadón infernal es un arma de combate a dos manos que otorga tanto un ataque adicional como un +1 a la Fuerza.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Raptor" id="d14e-290c-ff9a-6a5a" hidden="false">
      <modifiers>
        <modifier affects="profiles.Unidad" field="da036dbb-32c2-430a-9dd5-aa74e0c4f74b" scope="parent" type="increment" value="1"/>
      </modifiers>
      <profiles>
        <profile name="Raptor" id="67b5-3b5a-7985-2acc" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El raptor es un arma de combate cuerpo a cuerpo que otorga un +1 a la Fuerza, y que también sirve como gancho para arrastrar a un líder enemigo hasta las filas de los Infernales. Al realizar una maniobra de Atacar y Huir, un Avernarca puede señalar a un Personaje independiente involucrado en el mismo combate y tirar 1D6. Con un 2+, el Avernarca puede &quot;secuestrar&quot; a ese personaje, que será arrastrado con los Infernales. Cuando su movimiento de Atacar y huir haya finalizado, deja tantos Infernales como puedas en contacto peana con peana con la miniatura &quot;secuestrada&quot;; este nuevo combate se resolverá el próximo turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Espadón" id="5b3e-79d9-7fe8-8123" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="de72-5814-6792-66b4" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Espadón" id="11a3-f62c-df16-b12b" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El espadón es un arma de combate a dos manos de energía que otorga un +1 a la Fuerza.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Espadones compuestos" id="70fc-effa-4890-8098" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="4f31-c7f6-4963-4736" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Espadones compuestos" id="00d0-2667-0504-0b29" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Los espadones compuestos son armas de energía que pueden ser blandidos por separado (añadiendo un +2 al valor de Ataques del portador), o encajados entre ellos para formar un filo mucho más grande que otorgue un +2 a la Fuerza del portador (elige cual de los dos utilizar en cada ronda antes de que el portador efectúe sus ataques).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Matanza" id="9d05-57fc-e9cd-4528" hidden="false">
      <profiles>
        <profile name="Matanza" id="e129-427c-4432-14a6" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El Duelista encabeza su escuadra en una tormenta de afiladas espadas en movimiento. En un asalto, cualquier tirada para herir de 6 realizada tanto por el Duelista o un Íncubo de su unidad permitirá que esa miniatura efectúe un ataque adicional inmediatamente. Este ataque adicional no puede generar más ataques adicionales.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Asalto asesino" id="0040-8e90-6e83-e086" hidden="false">
      <infoLinks>
        <infoLink name="Enemigo Predilecto" id="07b7-6b29-18e0-b5ea" hidden="false" targetId="3fe5-67c3-5aee-a5e7" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Asalto asesino" id="2421-b1f5-0717-630c" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El Duelista elige a un enemigo con un gesto desafiante. Podrá designar a un Personaje independiente enemigo al principio de cada ronda de combate. El Duelista tiene la regla Enemigo predilecto cuando ataque a esa miniatura.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Lanzagranadas fantasma" id="5bdd-1bbd-cb28-50b9" hidden="false">
      <infoLinks>
        <infoLink name="Granadas de asalto" id="94b4-f56d-4b3f-6eb1" hidden="false" targetId="a9de-5c4c-d2c8-6676" type="infoGroup"/>
        <infoLink name="Granadas defensivas" id="01d3-4d81-58f8-39af" hidden="false" targetId="f5e9-e97c-ca02-307d" type="infoGroup"/>
      </infoLinks>
      <profiles>
        <profile name="Lanzagranadas fantasma" id="1564-2b74-8bf9-032d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura con un lanzagranadas fantasma, así como la unidad a la que se una, cuenta como si llevara granadas de asalto y defensivas.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Látigo electrocorrosivo" id="ca69-3064-1626-556a" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="ad25-3055-d5ed-c884" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Látigo electrocorrosivo" id="afae-d4a3-e19f-bd07" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El látigo electrocorrosivo es un arma de energía. Las miniaturas que sufran una o más heridas sin salvar de un látigo electrocorrosivo dividen su Fuerza por la mitad (redondeando hacia arriba) durante el resto de esa ronda de combate.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Marchitador" id="6501-2dff-df18-1c8c" hidden="false">
      <infoLinks>
        <infoLink name="Energía" id="dffa-0b54-174b-351b" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Marchitador" id="31d4-e88d-a886-4422" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El marchitador es un arma de energía que causa muerte instantánea a cualquier miniatura que sufra una herida sin salvar, independientemente de la Resistencia de la victima.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Arcangel del dolor" id="c2a4-0367-ba7e-ed04" hidden="false">
      <profiles>
        <profile name="Arcangel del dolor" id="52b9-9f10-4578-40a0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una vez por partida, durante tu fase de disparo, una miniatura con un Arcángel puede decidir liberarlo en vez de disparar. Todas las unidades enemigas a 8D6cm o menos del portador deben superar un chequeo de Liderazgo o reducir su Habilidad de armas y su Iniciativa a 1 hasta el final del turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Animus Vitae" id="9d0f-34a5-4c5f-16a7" hidden="false">
      <profiles>
        <profile name="Animus Vitae" id="f880-852e-9797-3616" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El Animus Vitae es un arma de combate cuerpo a cuerpo especial. Si el portador mata a una o más miniaturas enemigas en una ronda de combate, puede realizar un chequeo de Liderazgo al final de la ronda. Si supera el chequeo obtendrá inmediatamente un marcador de dolor.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Brazal quirúrgico" id="bee0-99f0-51fc-ef7a" hidden="false">
      <infoLinks>
        <infoLink name="Envenenada" id="6709-c988-0438-6916" hidden="false" targetId="48c8-bb35-6595-03d1" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Brazal quirúrgico" id="d386-b2c1-9f8a-a369" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El brazal quirúrgico es un arma envenenada (4+).
Además, la miniatura que sufra una herida sin salvar de un brazal quirúrgico padecerá una muerte instantánea (y además, de las más desagradables), independientemente de cuál sea su Resistencia.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Crisol de la maldición" id="e75a-ad1e-2ad8-a3c6" hidden="false">
      <profiles>
        <profile name="Crisol de la maldición" id="3bdb-39e3-6e79-3b59" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una vez por partida, durante la fase de disparo, una miniatura con el crisol de la maldición puede optar por abrirlo en vez de disparar. Todo psíquico a 8D6cm o menos del portador deberá superar un chequeo de Liderazgo o ser retirado del juego al volverse completamente loco. No se permiten salvaciones de ningún tipo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Manotijera" id="1f35-8e5a-bde2-cd69" hidden="false">
      <infoLinks>
        <infoLink name="Envenenada" id="fa3c-12e4-974f-834a" hidden="false" targetId="48c8-bb35-6595-03d1" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier affects="profiles.Unidad" field="5dff3e7c-e024-4030-a71d-03195ec06ea7" scope="parent" type="increment" value="1"/>
      </modifiers>
      <profiles>
        <profile name="Manotijera" id="1aad-1107-a9de-1587" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Se trata de un arma envenenada (3+) que otorga +1 Ataque. Ten en cuenta que puede combinarse con un arma de cuerpo a cuerpo adicional para un total de +2 Ataques.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Imagen clónica" id="e06c-f289-5cab-8f3c" hidden="false">
      <profiles>
        <profile name="Imagen clónica" id="3848-240e-cdfe-fef0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cuando el portador está en combate, tira 1D3 al principio de cada ronda de combate para representar cuantas imágenes clónicas estarán disponibles. El resultado es el número de impactos que el portador podrá anular totalmente durante ese turno, justo antes de la tirada para herir. El portador podrá elegir qué ataques anular. No obstante, una vez hecha la tirada para herir ya no habrá vuelta atrás, j así que elige cuidadosamente qué ataques querrás anular !</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Espiral de sombras" id="ef67-f9e3-25ba-8968" hidden="false">
      <infoLinks>
        <infoLink name="Espiral de sombras" id="97c8-2f9c-2f99-03d0" hidden="false" targetId="8cf6-1a29-85ea-2b45" type="profile"/>
      </infoLinks>
    </infoGroup>
    <infoGroup name="Máscara de ofuscación" id="af82-a46e-fb26-af5e" hidden="false">
      <profiles>
        <profile name="Máscara de ofuscación" id="39ec-ad95-a520-16da" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las unidades enemigas en contacto peana con peana con una miniatura equipada con la máscara de ofuscación deberán superar un chequeo de Liderazgo antes de efectuar ninguno de sus ataques. Si fallan
dudarán ante la visión de una ilusión tan cercana y no podrán atacar al portador durante esta ronda, no obstante podrán atacar a otras miniaturas de forma normal.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Portal a la Telaraña" id="6f5a-9f19-31aa-7ec8" hidden="false">
      <profiles>
        <profile name="Portal a la Telaraña" id="2475-536b-6db0-2fac" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una vez por partida, durante tu fase de disparo, una miniatura con un portal a la Telaraña puede decidir activarlo en vez de disparar.
Coloca un marcador de explosión pequeño que te sobre (u otro marcador de un tamaño similar) en contacto con la peana del portador al activar el portal. No se puede activar el portal desde el interior de un vehículo. A partir de entonces, cualquiera de tus unidades que lleguen desde la reserva pueden entrar en juego desde el borde del marcador del portal en vez de entrar normalmente (no importa si estas unidades simplemente quieren entrar por despliegue rápido, flanqueando, entrando desde su borde del tablero, etcétera). El portal cuenta como terreno infranqueable y no puede ser destruido. Tras activarlo, la miniatura que tenía el portal podrá apartarse libremente, dejando el portal en su sitio. Si cuentas con un portal a la Telaraña en tu ejército, puedes mantener unidades en reserva, independientemente de la misión que estéis jugando. Los vehículos no pueden entrar en juego mediante un portal a la Telaraña.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Trampa de almas" id="3407-07da-b3d5-6664" hidden="false">
      <profiles>
        <profile name="Trampa de almas" id="de84-0f35-6dfc-13a4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cuando el portador mate algún Personaje independiente enemigo o una Criatura monstruosa, puede decidir realizar un chequeo de Liderazgo. Si supera el chequeo, la esencia del enemigo será atrapada en la trampa de almas. El portador doblará su Fuerza inmediatamente para el resto de la partida (hasta un máximo de 10).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Aspilleras cristalinas" id="4133-da04-d86e-b325" hidden="false">
      <profiles>
        <profile name="Aspilleras cristalinas" id="192b-7139-907f-da4b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas con rifles cristalinos o pistolas cristalinas que disparen mientras estén embarcadas en este vehículo pueden repetir sus tiradas para Impactar, representando la gran cantidad de munición a su disposición.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Campo parpadeante" id="8b4e-f040-e84c-c4a8" hidden="false">
      <profiles>
        <profile name="Campo parpadeante" id="1fa8-db57-810d-bb0e" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un vehículo con un campo parpadeante cuenta con una salvación invulnerable de 5+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Filos envenenados" id="9dde-caf8-7707-cb43" hidden="false">
      <profiles>
        <profile name="Filos envenenados" id="2540-3678-0617-7c49" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cuando una unidad enemiga ataca a este vehículo durante la fase de asalto, sufrirá un impacto de Fuerza 4 FP- por cada &quot;1&quot; que obtenga en sus tiradas para impactar contra él (se distribuyen como si fueran disparos).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Ganchos colgantes" id="3238-2600-056f-89da" hidden="false">
      <profiles>
        <profile name="Ganchos colgantes" id="68a7-3eb8-8c50-4914" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un vehículo con ganchos colgantes causa 1D3+1 impactos de F4 y FP- en toda unidad enemiga no trabada en combate que no sea un vehículo a la que haya sobrevolado durante la fase de Movimiento, y se resuelven inmediatamente. Se pueden efectuar salvaciones por cobertura de forma normal.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Lanzagranadas Tormento" id="20b2-0a97-dc9c-e87b" hidden="false">
      <profiles>
        <profile name="Lanzagranadas Tormento" id="379f-e4a8-c10e-5408" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cualquier unidad enemiga que se encuentre a 15cm o menos de uno más vehículos con lanzagranadas Tormento sufrirá un -1 a su Liderazgo. Las unidades enemigas deberán superar un chequeo de Moral si quieren asaltar a estos vehículos; si se falla el chequeo no podrán asaltar durante ese turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Pantalla de oscuridad" id="db35-275f-3e2d-338e" hidden="false">
      <profiles>
        <profile name="Pantalla de oscuridad" id="82eb-57dc-4c6f-daa0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La cubierta del vehículo está rodeada por un campo desplazador de amplio espectro, que envuelve el vehículo en una fría oscuridad impenetrable. Esto tiene el efecto de reducir el alcance de las unidades enemigas que quieran disparar a este vehículo en 15cm. Por ejemplo, una unidad equipada con bólteres (alcance 60cm) contaría como si tuviera un alcance de 45cm cuando fuera a disparar a un vehículo con pantalla de oscuridad. Este ajuste puede situar virtualmente al vehículo más allá del alcance de los disparos del enemigo, en cuyo caso el disparo fallaría automáticamente. La distancia adicional también se tiene en cuenta para ver si el vehículo se encuentra dentro del alcance del fuego rápido, si se encuentra a medio alcance a efectos de los disparos de fusión, etcétera. La pantalla de oscuridad no tiene efecto en las armas de plantilla o las de barrera de artillería, ni tampoco en las armas con un alcance máximo de 15cm o menos.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Proa de choque" id="4959-6692-e9a1-76de" hidden="false">
      <profiles>
        <profile name="Proa de choque" id="9363-3cbe-0032-c3f3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un vehículo con una proa de choque puede efectuar Brutalidad acorazada sobre las unidades enemigas. Cuando embista a vehículos enemigos contará como si su blindaje frontal fuera 1D3 puntos mejor de lo normal (tira el dado cada vez que intentes una embestida distinta).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Retromotores" id="8e8d-bca1-c6a9-7a8e" hidden="false">
      <profiles>
        <profile name="Retromotores" id="0f99-63b4-83d3-6cbc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un vehículo equipado con retromotores puede entrar por Despliegue rápido. No obstante, las tropas de su interior no podrán desembarcar ese turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Trofeos atroces" id="15fb-ad3f-24c8-61d7" hidden="false">
      <profiles>
        <profile name="Trofeos atroces" id="4717-a486-04ef-d441" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una unidad amiga a 15cm o menos de un vehículo con trofeos atroces puede repetir cualquier tirada de Liderazgo fallida.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Velamen etéreo mejorado" id="9ac7-af16-7f00-4a71" hidden="false">
      <profiles>
        <profile name="Velamen etéreo mejorado" id="103f-030c-8840-0a3f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura con velamen etéreo mejorado puede mover 5D6cm adicionales, a pesar de que los pasajeros no podrán desembarcar ese turno, y el vehículo y sus pasajeros no podrán disparar en su siguiente fase de Disparo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Granadas de disrupción" id="3580-f78e-65e5-b0d7" hidden="false">
      <infoLinks>
        <infoLink name="Granadas de disrupción" id="ac77-a76c-8cf8-d7a2" hidden="false" targetId="bfed-c438-e1b1-adef" type="profile"/>
      </infoLinks>
    </infoGroup>
    <infoGroup name="Armadura fantasma" id="8814-80fc-851c-06ca" hidden="false">
      <profiles>
        <profile name="Armadura fantasma" id="58e0-d149-eeb5-8240" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La armadura fantasma también incorpora la tecnología de un pequeño campo de fuerza para proteger al portador con mayor efectividad. La armadura fantasma confiere una salvación por armadura de 4+ y una salvación invulnerable de 6+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
  </sharedInfoGroups>
  <sharedProfiles>
    <profile name="Aberración" id="1261e7c1-816c-4fde-b01e-bf281d7677e9" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
