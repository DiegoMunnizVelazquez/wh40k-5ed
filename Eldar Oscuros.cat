      </infoLinks>
      <profiles>
        <profile name="Ama de los venenos (Lhamaeana)" id="4519-7c0b-84cc-f103" hidden="false" noindex="true" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Todas las armas envenenadas (tanto de disparo como las de combate cuerpo a cuerpo) que portan las Lhameanas y su Arconte mejoran a Envenenadas (2+).</characteristic>
          </characteristics>
        </profile>
        <profile name="Poder del Dolor (Lhamaeana)" id="306f-e90d-c7fb-ec05" hidden="false" noindex="true" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
