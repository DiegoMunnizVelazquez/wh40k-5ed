      <infoLinks>
        <infoLink name="Rifle maléfico" id="ebf52e3b-e869-4b07-9eea-fcf727f7ea43" hidden="false" targetId="b0079921-9c70-4a65-8c35-52624705293e" type="profile"/>
        <infoLink name="Francotirador" id="e3350b91-58a6-41d2-b16c-306a43e20bab" hidden="false" targetId="7636-0a2f-8c61-f9b2" type="rule"/>
