    <selectionEntry name="Kheradruakh" id="c7903b9d-06f7-40ba-b868-8c61163d5585" hidden="false" import="true" type="model">
      <constraints>
        <constraint id="6f1a-bd44-d45e-91d0" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="140"/>
      </costs>
      <infoLinks>
        <infoLink name="Kheradruakh" id="a279-6422-9d6d-9cc8" hidden="false" targetId="0af66ccb-24c6-4f4d-aef9-ab294d593605" type="profile"/>
        <infoLink name="Moverse a Través de Cobertura" id="25d0-164a-bbff-8036" hidden="false" targetId="6cf1-d139-8b14-6083" type="rule"/>
        <infoLink name="Sigilo" id="46e4-8dea-bed2-f73a" hidden="false" targetId="f1ee-e19a-a3c3-6797" type="rule"/>
        <infoLink name="Rayo castigador" id="6d9c-65fc-e748-c2b9" hidden="false" targetId="b2cd7afd-5643-4fde-bc31-c94fbb00da62" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Decapitador" id="9ff8-0898-c9c7-9c22" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Ésta es un arma de energía que causa Muerte instantánea con un resultado de 6 en la tirada para herir, independientemente de la Resistencia del enemigo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Salvación especial" id="88e2-740f-415f-df20" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Tiene una salvación invulnerable de 5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Acechante sombrio" id="2400-1846-c7a8-a361" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Kheradruakh debe mantenerse en reserva, independientemente de la misión. Cuando llegue desde la reserva, simplemente limítate a colocarlo en cualquier punto del campo de batalla más allá de 3cm de cualquier miniatura enemiga (a ser posible mientras ríes maliciosamente). No podrá asaltar ese turno, pero por lo demás, podrá actuar normalmente.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cazador de cabezas" id="045d-009b-5d8a-be0e" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Designa un Personaje independiente enemigo al principio de la partida, esa será la calavera que se le habrá antojado al Decapitador. Kheradruakh tiene la regla especial Enemigo Predilecto cuando ataque a esa miniatura.</characteristic>
          </characteristics>
        </profile>
        <profile name="Físico alterado" id="73be-9947-8b7c-baa1" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Kheradruakh es una criatura forjada en la oscuridad más pretérita. Empieza el juego con un marcador de dolor.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
