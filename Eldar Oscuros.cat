    <infoGroup name="Orbe de angustias" id="e9b93f5f-ff37-4b4d-a0ae-00005a5cc063" hidden="false">
      <infoLinks>
        <infoLink name="Orbe de angustias" id="0d56f236-b26c-443c-bfef-3a6ec6544ce7" hidden="false" targetId="40e98732-04e6-470a-aba7-cbd8fe6abc77" type="profile"/>
        <infoLink name="Área" id="69a35772-8cb0-4851-afbe-adcd3e32d710" hidden="false" targetId="31c7-fe6c-af95-f0b5" type="rule"/>
        <infoLink name="Asalto" id="379a25cd-cee6-4fb9-aaf6-f9b4c1af48f8" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Orbe de angustias" id="d839-92b3-deb3-31bc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">*Al tirar para herir, el orbe de angustias tira contra el Liderazgo de su objetivo, no contra su Resistencia. Las miniaturas sin atributo de Liderazgo no serán afectadas.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Orbes de obsidiana" id="d5baee93-22b8-41e2-a4b6-5632cf908ea7" hidden="false">
      <infoLinks>
        <infoLink name="Orbes de obsidiana" id="2fe4eaae-c2ec-4eb8-a711-1d0f14758906" hidden="false" targetId="91aa190b-463a-43ba-a46a-ae371be6d254" type="profile"/>
        <infoLink name="Área" id="90997f56-1fd3-4c28-b27e-becbcd7cc18a" hidden="false" targetId="31c7-fe6c-af95-f0b5" type="rule"/>
        <infoLink name="Asalto" id="0be774a6-48d3-4161-96c4-77fce77400b4" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Orbes de obsidiana" id="de04-9e51-8ef9-3ec4" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">*Tira contra el Liderazgo del enemigo, en vez de contra su Resistencia. Las miniaturas sin valor de Liderazgo no son afectadas.
Cada herida causada por un orbe de obsidiana curará una de las heridas que Vect haya sufrido anteriormente durante la batalla.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
