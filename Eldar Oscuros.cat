    <selectionEntry name="Brazal de trance" id="3f06-be5f-a0dc-aaea" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Brazal de trance" id="1488-94a6-bdfc-cb68" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El brazal de trance es un arma especial de combate cuerpo a cuerpo. Un Personaje independiente o Criatura monstruosa que haya sido impactado por un brazal de trance deberá superar un chequeo de Fuerza y uno de Liderazgo por cada impacto sufrido. Si falla alguno de dichos chequeos, la miniatura ha sucumbido al brazal de trance y no podrá realizar más ataques en esa fase de asalto.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Brazales hidra" id="2422-071d-1120-6b15" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Brazales hidra" id="1c3e-3364-d323-8afe" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Cuentan como dos armas de combate cuerpo a cuerpo; no obstante, en vez de proporcionar +1 ataque adicional, confieren +1D6 ataques adicionales. Tira al principio de cada rondade combate para determinar el número de ataques adicionales.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Filored y empalador" id="b83d-7157-a61b-61a3" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Filored y empalador" id="c711-edd4-de29-a301" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Un juego de filored y empalador cuenta como dos armas de combate cuerpo a cuerpo. Además, para representar los efectos inmovilizantes de la filored, toda miniatura enemiga en contacto peana con peana con el portador combatirá con un Ataque menos (hasta un mínimo de 1).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Flagelos encadenados" id="a5b2-8ec5-8ef4-f5e3" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Flagelos encadenados" id="4e56-038d-6a48-d624" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Los flagelos encadenados cuentan como dos armas de combate cuerpo a cuerpo. Para representar el hecho de que los flagelos son virtualmente imposibles de bloquear o esquivar, el portador puede repetir los chequeos para impactar y para herir en cuerpo a cuerpo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Espada fantasma" id="6d2e-1c70-7bb7-6d1b" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Espada fantasma" id="6bd1-5ef6-9f32-10a7" hidden="false" targetId="92db-b8ca-23ad-9e80" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Espada venenosa" id="5e89-4843-eef5-82d6" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Espada venenosa" id="ee81-eab3-1f82-b23f" hidden="false" targetId="c2bf-3e6f-5463-35ba" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Espadón infernal" id="0d46-d25e-1fe5-9e25" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Espadón infernal" id="0fb6-b758-ecb1-c09a" hidden="false" targetId="6871-685e-b30b-770a" type="infoGroup"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Raptor" id="1e0e-2a02-cf05-b7e1" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Raptor" id="fc3e-483a-9c5c-1422" hidden="false" targetId="d14e-290c-ff9a-6a5a" type="infoGroup"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Espadón" id="b227-73c7-5e73-1c1c" hidden="false" import="true" type="upgrade">
      <modifiers>
        <modifier affects="profiles.Unidad" field="da036dbb-32c2-430a-9dd5-aa74e0c4f74b" scope="parent" type="increment" value="1"/>
      </modifiers>
      <profiles>
        <profile name="Espadón" id="797e-431e-b4a6-465b" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El espadón es un arma de combate a dos manos de energía que otorga un +1 a la Fuerza.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Espadones compuestos" id="1414-2383-3985-35ec" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Espadones compuestos" id="6b05-23d7-144d-c0d9" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Los espadones compuestos son armas de energía que pueden ser blandidos por separado (añadiendo un +2 al valor de Ataques del portador), o encajados entre ellos para formar un filo mucho más grande que otorgue un +2 a la Fuerza del portador (elige cual de los dos utilizar en cada ronda antes de que el portador efectúe sus ataques).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Asalto asesino" id="5302-95f8-2f2d-9853" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Asalto asesino" id="b282-66a8-5cda-35d8" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El Duelista elige a un enemigo con un gesto desafiante. Podrá designar a un Personaje independiente enemigo al principio de cada ronda de combate. El Duelista tiene la regla Enemigo predilecto cuando ataque a esa miniatura.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Matanza" id="c7c2-f58c-54b0-4806" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Matanza" id="d5ff-db7e-1193-3677" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El Duelista encabeza su escuadra en una tormenta de afiladas espadas en movimiento. En un asalto, cualquier tirada para herir de 6 realizada tanto por el Duelista o un Íncubo de su unidad permitirá que esa miniatura efectúe un ataque adicional inmediatamente. Este ataque adicional no puede generar más ataques adicionales.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Lanzagranadas fantasma" id="fd2b-541c-72c3-74b0" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Lanzagranadas fantasma" id="767c-6c37-3f1d-8e54" hidden="false" targetId="3ebf-bb20-dacb-e5f3" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Marchitador" id="197f-be69-da3f-41c8" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Marchitador" id="e045-1937-7d62-7bff" hidden="false" targetId="ad08-3ff6-9a99-bde7" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Látigo electrocorrosivo" id="e1e1-2ff6-8ede-2fc9" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Látigo electrocorrosivo" id="c314-7ad5-ec43-c90f" hidden="false" targetId="fc73-d8b5-6927-5ab0" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Arcángel del dolor" id="4b46-2120-f33e-ba36" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="2483-77d8-34e8-40cb" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Arcangel del dolor" id="e29d-dfd2-c227-e730" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una vez por partida, durante tu fase de disparo, una miniatura con un Arcángel puede decidir liberarlo en vez de disparar. Todas las unidades enemigas a 8D6cm o menos del portador deben superar un chequeo de Liderazgo o reducir su Habilidad de armas y su Iniciativa a 1 hasta el final del turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Animus Vitae" id="fb95-4d5e-a7cd-37cb" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="9125-3479-b8a0-77c4" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Animus Vitae" id="991d-f6a5-4eee-6219" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El Animus Vitae es un arma de combate cuerpo a cuerpo especial. Si el portador mata a una o más miniaturas enemigas en una ronda de combate, puede realizar un chequeo de Liderazgo al final de la ronda. Si supera el chequeo obtendrá inmediatamente un marcador de dolor.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Brazal quirúrgico" id="2f72-eb3c-f854-d4b3" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Brazal quirúrgico" id="896c-f90a-390a-a1d7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El brazal quirúrgico es un arma envenenada (4+).
Además, la miniatura que sufra una herida sin salvar de un brazal quirúrgico padecerá una muerte instantánea (y además, de las más desagradables), independientemente de cuál sea su Resistencia.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Crisol de la maldición" id="1995-5496-efef-624a" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="c5b8-5c15-8fa4-2e5c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Crisol de la maldición" id="5db5-522f-df55-f139" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una vez por partida, durante la fase de disparo, una miniatura con el crisol de la maldición puede optar por abrirlo en vez de disparar. Todo psíquico a 8D6cm o menos del portador deberá superar un chequeo de Liderazgo o ser retirado del juego al volverse completamente loco. No se permiten salvaciones de ningún tipo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Manotijera" id="f5ef-e000-d2b9-225c" hidden="false" import="true" type="upgrade">
      <modifiers>
        <modifier affects="profiles.Unidad" field="5dff3e7c-e024-4030-a71d-03195ec06ea7" scope="parent" type="increment" value="1"/>
      </modifiers>
      <profiles>
        <profile name="Manotijera" id="1c11-d3c6-60d6-69c2" hidden="false" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate">
          <characteristics>
            <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Se trata de un arma envenenada (3+) que otorga +1 Ataque. Ten en cuenta que puede combinarse con un arma de cuerpo a cuerpo adicional para un total de +2 Ataques.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Imagen clónica" id="6295-b620-3070-549a" hidden="false" import="true" type="upgrade">
      <infoLinks>
        <infoLink name="Imagen clónica" id="0093-28a8-6b0a-86c8" hidden="false" targetId="1649-5424-f34e-2de4" type="profile"/>
