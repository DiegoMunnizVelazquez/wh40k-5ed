      <infoLinks>
        <infoLink name="Espiral de sombras" id="ab22-3343-aca3-48f5" hidden="false" targetId="8cf6-1a29-85ea-2b45" type="profile"/>
      </infoLinks>
    </selectionEntry>
    <selectionEntry name="Máscara de ofuscación" id="0f13-d3e6-bf5a-ce95" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Máscara de ofuscación" id="cb1b-1d05-e875-fc3d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las unidades enemigas en contacto peana con peana con una miniatura equipada con la máscara de ofuscación deberán superar un chequeo de Liderazgo antes de efectuar ninguno de sus ataques. Si fallan
dudarán ante la visión de una ilusión tan cercana y no podrán atacar al portador durante esta ronda, no obstante podrán atacar a otras miniaturas de forma normal.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Portal a la Telaraña" id="a693-88ba-5c7a-b8c1" hidden="false" import="true" type="upgrade">
