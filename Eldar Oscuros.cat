          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los atormentados empiezan la batalla con un marcador de dolor</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Atormentados" id="36c1-f36d-ad1c-73c3" defaultSelectionEntryId="2a24-40c0-eed3-0993" hidden="false" sortIndex="1">
          <constraints>
            <constraint id="c605-8951-e5e1-98ea" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="10"/>
            <constraint id="4599-afd3-56c9-f6ff" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="3"/>
