    <infoGroup name="Jarran Kell" id="e0e87b3b-8e77-40e1-8835-639bb7bcca80" hidden="false">
      <infoLinks>
        <infoLink name="Jarran Kell" type="profile" targetId="0ee5f435-df85-4f26" id="0b015043-9be6-43a9-a1bf-2162e80fc4ea" hidden="false"/>
        <infoLink name="Cuidado ¡Arghh!" id="877a-e199-01f6-83b9" hidden="false" type="profile" targetId="4062-25e2-9491-cd31"/>
      </infoLinks>
      <profiles>
        <profile name="¡Atended gusanos!" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="bbbd-3395-1008-0bd1" publicationId="46cd-a15f-f8aa-0899" page="57">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si Kell se encuentra en la misma unidad que un oficial, los chequeos de Liderazgo que se hagan para recibir las ordenes de ese oficial se harán con el valor de Liderazgo del oficial y no con el de la unidad que las recibe.</characteristic>
          </characteristics>
        </profile>
        <profile name="Protector dedicado" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="bc50-7c18-9c5c-dd3f" publicationId="46cd-a15f-f8aa-0899" page="57">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si Creed y Kell estan en la misma unidad, Kell obtiene la regla Cuidado |Arghh! descrita en la página 31.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
