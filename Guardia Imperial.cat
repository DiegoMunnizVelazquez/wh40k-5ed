    <infoGroup name="Psíquico Primaris" id="e4949679-dc14-44ba-a9e7-84419afa2b25" hidden="false">
      <infoLinks>
        <infoLink name="Psíquico Primaris" type="profile" targetId="96228497-8f54-446e" id="32d9290c-6351-4cd3-a5e3-5ab7d077d5ad" hidden="false"/>
        <infoLink name="Personaje independiente" id="59b9-1fe0-4104-7b62" hidden="false" type="rule" targetId="61b4-c5bb-9d85-8506"/>
      </infoLinks>
      <profiles>
        <profile name="Es por tu propio bien" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="34fa-3d1d-cfd8-5179" publicationId="46cd-a15f-f8aa-0899" page="33">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si un Psíquico Primáris sufre un ataque de los Peligros de la Disformidad mientras se encuentre en la misma unidad que un comisario (de cualquier tipo), entonces el Psíquico será ejecutado inmediatamente y retirado del juego.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mantoscuro" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico" hidden="false" id="3a27-eb91-c38b-0923" publicationId="46cd-a15f-f8aa-0899" page="33">
          <characteristics>
            <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">Unidad</characteristic>
            <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">Este poder se utiliza al principio de la fase de Movimiento del psíquico. Si tiene éxito, cualquier unidad que quiera disparar sobre el psíquico (o la unidad en la que se encuentre) deberá superar antes un chequeo de Liderazgo o no actuará durante esta fase de disparo (los vehículos cuentan con Liderazgo 10 por lo que se refiere al Mantoscuro). Los efectos de este poder duran hasta la siguiente fase de Movimiento del Psíquico Primaris.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoGroups>
        <infoGroup name="Arco relampagueante" id="7d82-3d3c-f899-9231" hidden="false" publicationId="46cd-a15f-f8aa-0899" page="33">
          <profiles>
            <profile name="Arco relampagueante" typeId="9c33-b0c8-74bd-e5a7" typeName="Poder Psíquico (Proyectil)" hidden="false" id="5284-3c08-c4d1-93a6">
              <characteristics>
                <characteristic name="Alcance" typeId="5bf6-378a-0cb7-b079">60cm</characteristic>
                <characteristic name="F" typeId="12da-9b3e-f37b-bc35">6</characteristic>
                <characteristic name="FP" typeId="10b5-aa5b-ccde-79cc">5</characteristic>
                <characteristic name="Tipo" typeId="20e7-cbcb-1781-a732">Asalto 2D6</characteristic>
                <characteristic name="Detalles" typeId="a812-390d-dff6-dabd">Disparo</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Asalto" id="8975-aed2-233e-c604" hidden="false" type="rule" targetId="8714-46ad-62c0-ce35"/>
          </infoLinks>
        </infoGroup>
      </infoGroups>
    </infoGroup>
