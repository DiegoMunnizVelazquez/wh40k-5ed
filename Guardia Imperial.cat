        <cost name="Pts" typeId="puntos" value="50"/>
      </costs>
      <infoGroups>
        <infoGroup name="Noble comandante Pask" id="3e2f-8da8-4b90-be0a" hidden="false">
          <profiles>
            <profile name="As del tanque Leman Russ" id="dec8-eb99-8857-9a1d" hidden="false" page="58" publicationId="46cd-a15f-f8aa-0899" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El Leman Russ de Pask puede utilizar su Habilidad de Proyectiles de 4.
Si el Leman Russ resulta Destruido, Pask habrá muerto.</characteristic>
              </characteristics>
            </profile>
            <profile name="Disparo letal" id="0945-1110-b9ec-4fcd" hidden="false" page="58" publicationId="46cd-a15f-f8aa-0899" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si el Leman Russ de Pask no ha movido durante la fase de Movimiento, todos los disparos efectuados por el Leman Russ de Pask se benefician de la regla Disparo Letal.


Al utilizar el disparo Letal contra un vehículo, todos los impactos añaden un +1 a las tiradas de penetración.
Al utilizar el disparo Letal contra una criatura monstruosa, todas las tiradas para Herir falladas pueden repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <modifiers>
        <modifier affects="profiles.Vehículo" field="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5" scope="parent" type="set" value="4"/>
        <modifier field="name" join=" " scope="parent" type="append" value="de Pask"/>
        <modifier affects="profiles.Vehículo" field="name" scope="parent" type="append" value="de Pask"/>
      </modifiers>
    </selectionEntry>
