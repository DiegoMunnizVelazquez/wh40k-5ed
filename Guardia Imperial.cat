          <profiles>
            <profile name="Ojo maldito" id="cb12-8f53-d615-c2a0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El ojo maldito de Yarrick es un implante biónico que incorpora un poderoso laser. Puede dispararse en la fase de disparo además del resto de armas. El ojo maldito tiene el mismo perfil que una pistola láser sobrecargada y le da a Yarrick un ataque extra en el cuerpo a cuerpo (ya incluido en su perfil).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Campo de fuerza" id="bdaa-0cc4-f72f-e116" hidden="false" import="true" sortIndex="6" type="upgrade">
          <constraints>
            <constraint id="8b4d-fcd3-c26f-1e1a-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="8b4d-fcd3-c26f-1e1a-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Campo de fuerza" id="68f8-779f-1030-cf54" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Yarrick esta protegido por un campo de fuerza especial que reduce la potencia de los ataques enemigos. Cualquier herida asignada a Yarrick debe repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
