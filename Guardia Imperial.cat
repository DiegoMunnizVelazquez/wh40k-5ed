    <infoGroup name="Hydra" id="ffa23a98-fc29-4376-9846-8c31ad43c071" hidden="false">
      <infoLinks>
        <infoLink name="Hydra" id="605d7f96-0e8b-4886-ba48-340a4bb62cf6" hidden="false" targetId="ddcc-ae99-0b57-3583" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Sistema de puntería automático" id="e1a3-1726-5a8d-1d01" hidden="false" page="51" publicationId="46cd-a15f-f8aa-0899" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los vehículos gravíticos no pueden beneficiarse de la salvación de cobertura por moverse a toda velocidad contra los disparos efectuados por el Hydra. Del mismo modo, las motocicletas no pueden beneficiarse de la salvación obtenida gracias a sus turbopropulsores contra los disparos del Hydra.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
