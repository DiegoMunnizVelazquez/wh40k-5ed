        <selectionEntry type="upgrade" import="true" name="Campo de fuerza" hidden="false" id="bdaa-0cc4-f72f-e116" sortIndex="6">
          <profiles>
            <profile name="Campo de fuerza" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="68f8-779f-1030-cf54">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Yarrick esta protegido por un campo de fuerza especial que reduce la potencia de los ataques enemigos. Cualquier herida asignada a Yarrick debe repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
