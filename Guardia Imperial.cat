    <infoGroup name="Sacerdote del Ministorum" id="dbec331e-bdd8-42b9-a98a-db884bf6b85d" hidden="false">
      <infoLinks>
        <infoLink name="Sacerdote del Ministorum" type="profile" targetId="8bf24c5f-3dd7-4b9f" id="7e3e655b-39c2-47a1-8817-d924c74e0e78" hidden="false"/>
        <infoLink name="Personaje independiente" id="d8de-b2fe-5e8f-1ef0" hidden="false" type="rule" targetId="61b4-c5bb-9d85-8506"/>
      </infoLinks>
      <profiles>
        <profile name="Furia honrosa" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="19f3-b24c-ef95-8265" publicationId="46cd-a15f-f8aa-0899" page="35">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Un Sacerdote y su unidad pueden repetir las tiradas para Impactar en Cuerpo a cuerpo falladas en el turno en el que asaltan. La Furia honrosa no tiene efecto sobre los ogretes, que se pierden con la retórica del sacerdote, ni sobre los Ratlings, demasiado ocupados en mantenerse vivos como para prestar atención.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
    <infoGroup name="Sargento armero Harker" id="4bd51820-c6fd-470e-ab2b-b2eab1379305" hidden="false">
      <infoLinks>
        <infoLink name="Sargento armero Harker" type="profile" targetId="a1fff065-70eb-4f7c" id="5347cb35-766b-4b86-9bad-76605362e11d" hidden="false"/>
        <infoLink name="No Hay Dolor" id="ec49-5a42-3ac5-4422" hidden="false" type="rule" targetId="fe28-c924-099d-aa4e"/>
        <infoLink name="Implacables" id="88c5-031b-9763-794e" hidden="false" type="rule" targetId="470c-bf6a-caae-15c9"/>
      </infoLinks>
      <infoGroups>
        <infoGroup name="Diablos de Catachán" id="61d7-0927-04fb-d07e" hidden="false">
          <profiles>
            <profile name="Diablos de Catachán" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="d56e-0164-8491-82ba" publicationId="46cd-a15f-f8aa-0899" page="62">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Harker y su escuadrón tienen las reglas especiales Infiltración, Sigilo y Moverse a través de cobertura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Infiltración" id="0175-8dec-539d-c638" hidden="false" type="rule" targetId="3310-5f06-776a-5b35"/>
            <infoLink name="Sigilo" id="506a-b153-b31e-bc65" hidden="false" type="rule" targetId="f1ee-e19a-a3c3-6797"/>
            <infoLink name="Moverse a Través de Cobertura" id="e261-7f29-e8bd-3946" hidden="false" type="rule" targetId="6cf1-d139-8b14-6083"/>
