    <profile name="Mortero de asedio Colossus" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="bf62-0817-aa85-8ee5">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60-600cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Barrera de artillería 1, Área grande</characteristic>
      </characteristics>
    </profile>
    <profile name="Mortero pesado Griffon" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="7db3-ac99-cbea-d88b">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">30-120cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Barrera de artillería 1, Área grande</characteristic>
      </characteristics>
    </profile>
    <profile name="Bombas trampa" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="9ea1-c853-0521-bef2" publicationId="46cd-a15f-f8aa-0899" page="40">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las unidades equipadas con Bombas trampa se consideran equipadas con Granadas defensivas</characteristic>
      </characteristics>
    </profile>
    <profile name="Campo reflector" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="0187-28b4-d81a-c03c" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La miniatura equipada con un campo reflector gana una tirada de salvación invulnerable de 5+</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura caparazón" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="521a-95cb-9816-51b4" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas equipadas con una armadura caparazón tienen una salvación por armadura de 4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Capas de camuflaje" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="ac6d-8fc0-9ae7-76a5" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas equipadas con capas de camuflaje tienen la regla sigilo</characteristic>
      </characteristics>
    </profile>
    <profile name="Lanzagranadas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="796a-ac92-f8f0-df3f">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cada vez que se dispare el lanzagranadas, el jugador podrá decidir con que tipo de munición lo hace, perforante o fragmentación</characteristic>
      </characteristics>
    </profile>
    <profile name="Botiquín" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="3890-cbc7-76fe-ae69" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Mientras el médico siga con vida, su escuadrón tiene la regla de ¡No hay Dolor!</characteristic>
      </characteristics>
    </profile>
    <profile name="Estandarte de regimiento" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="da75-ecc9-f72c-63b7" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Mientras el portaestandarte siga con vida, su escuadrón contará como que ha hecho una herida adicional a la hora de calcular el resultado de un asalto. Adicionalmente, todas las unidades a 30cm pueden repetir las tiradas fallidas de Moral y Acobardamiento.</characteristic>
      </characteristics>
    </profile>
    <profile name="Amplificador de voz" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="a90a-65af-a77e-545a" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si un oficial intenta dar una orden a una unidad aliada y tanto la unidad de mando como la que la recibe cuentan con un amplificador de voz, se podrá repetir la tirada de Liderazgo para determinar si la orden se transmite correctamente (en caso de que esta falle).</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura antifrag" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="d7f4-0696-db9b-7b50" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas equipadas con una armadura antifrag tienen una salvación por armadura de 5+</characteristic>
      </characteristics>
    </profile>
    <profile name="Enlace telepático" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="5e56-2922-d0b7-9326" publicationId="46cd-a15f-f8aa-0899" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Mientras el Astrópata siga vivo, añade 1 a tus tiradas de reserva. Adicionalmente si alguna de tus unidades llega mediante la regla Flanquear, podrás repetir la tirada para determinar el lado por el que llegan.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bombardeo de Artillería" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="77b5-6ab6-5f07-63c4" publicationId="46cd-a15f-f8aa-0899" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Se considera un ataque de disparo realizado por el Maestro de Artillería.


*Tira 2D6 y la plantilla se dispersará 2=5 cm; 3=8 cm; 4=10 cm; 5=12 cm; 6=15 cm; 7=18 cm; 8=20 cm; 9=22 cm; 10=25 cm; 11=28 cm; 12=30cm en la dirección indicada por la flecha en el resultado de &quot;Impacto&quot;. Si obtenemos una flecha, la plantilla se dispersará otro D6 adicional (resultando en una desviación total de 3D6, 13=33 cm; 14=35 cm; 15=38 cm; 16=40 cm; 17=42 cm; 18=45 cm). En cualquier caso, si el Maestro Artillero tiene línea de visión con su objetivo reducirá del valor de la tirada su Habilidad de Disparo. Este ataque no podrá realizarse si el Maestro Artillero ha movido en la fase de Movimiento anterior.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bombardeo de Artillería" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="ceaf-49a5-656d-3af2">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Ilimitado</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">9</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Barrera de Artillería 1*</characteristic>
      </characteristics>
    </profile>
    <profile name="Interceptar reservas" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="b0e5-8b5b-0cad-f53c" publicationId="46cd-a15f-f8aa-0899" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Mientras el Oficial de flota siga vivo, tu oponente debe restar 1 a todas sus tiradas de reservas. Adicionalmente si la unidad enemiga llega usando la regla Flanquear, puedes obligar a repetir el dado por el que se determina el lado de la mesa por la que entrará la unidad.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cuidado ¡Arghh!" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="4062-25e2-9491-cd31" publicationId="46cd-a15f-f8aa-0899" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Mientras los guardaespaldas sigan con vida, hasta dos heridas recibidas por el Comandante deberán asignarse a el/los Guardaespaldas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Oficial veterano" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="f604-a93b-9e5d-bb7d" publicationId="46cd-a15f-f8aa-0899" page="30">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El Comandante de Compañía puede dar hasta dos órdenes por turno. Tiene un radio de mando de 30 cm. Los Comandantes de compañía pueden utilizar las órdenes ¡Derribadlo!, ¡Fuego en mi marca! y ¡Volved a la formación! así como las órdenes Primera línea ¡Fuego!, segunda línea ¡Fuego!, ¡A cubierto! y ¡Moveos! ¡Moveos! ¡Moveos!</characteristic>
      </characteristics>
    </profile>
    <profile name="Ordenes de Comandante de compañía" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="1f93-f09e-fe77-38f3" publicationId="46cd-a15f-f8aa-0899" page="30">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">-
¡Derribadlo! 
Si la orden se transmite con éxito, escoge un vehículo (o escuadrón de vehículos) o una criatura monstruosa (o unidad de criaturas monstruosas) rivales en línea de visión del oficial. La unidad que recibe la orden disparará inmediatamente al objetivo designado, contando como si sus armas fueran acopladas.


¡Fuego en mi marca! 
Si la orden se transmite con éxito, determina una unidad enemiga en línea de visión del oficial. La unidad que recibe la orden inmediatamente abre fuego sobre el objetivo. Las tiradas de salvación por cobertura que el objetivo obtenga con éxito deberán repetirse.


¡Volved a la formación! 
Esta orden solo puede aplicarse sobre una unidad en ¡Retirada! o que se encuentre Cuerpo a tierra. Si la orden se transmite con éxito, la unidad se reagrupará inmediatamente si se encuentra en ¡Retirada! (incluso si en condiciones normales no pudiese hacerlo a causa de las bajas sufridas, proximidad con el enemigo y demás...) o vuelve a la normalidad (si se encontraba Cuerpo a tierra). Como resultado, la unidad que recibe esta orden podrá disparar y asaltar de forma normal este turno.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ordenes de Comandante de pelotón" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="3f66-be65-553a-e782" publicationId="46cd-a15f-f8aa-0899" page="36">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">-
Primera línea ¡Fuego!, segunda línea ¡Fuego!
Si la orden se transmite correctamente, la unidad que la recibe abre fuego inmediatamente sobre cualquier objetivo a la vista. Si el enemigo se encuentra a menos de 30 cm, las miniaturas disparando rifles láser pueden hacer tres disparos en lugar de dos. Si la unidad no se ha movido durante la fase de movimiento podrá disparar dos veces (y no una) sobre un enemigo que se encuentre a una distancia de hasta 60cm.


¡A cubierto! 
Si la orden se transmite correctamente, la unidad que la recibe se arroja cuerpo a tierra. La unidad obtiene un +2 a su salvación por cobertura en lugar del bono habitual. Ten en cuenta que esto significa que la unidad no podrá volver a actuar normalmente hasta el final del siguiente turno del jugador.


¡Moveos! ¡Moveos! ¡Moveos! 
Si la orden se transmite correctamente, la unidad que la recibe inmediatamente correrá, tirando tres dados y utilizando el valor más alto para determinar la distancia de la carrera.</characteristic>
      </characteristics>
    </profile>
    <profile name="Destripador" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="a457-e896-cff7-9785" publicationId="46cd-a15f-f8aa-0899" page="42">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">30cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 3</characteristic>
      </characteristics>
    </profile>
    <profile name="Corpulento" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="9ea1-34c2-f7d5-234b" publicationId="46cd-a15f-f8aa-0899" page="42">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cada Ogrete cuenta como si fueran 2 miniaturas por lo que respecta al transporte.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cañón de plasma Executioner" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="1563-6f25-ab43-c1e6">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">90cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pesada 3, Área</characteristic>
      </characteristics>
    </profile>
    <profile name="Aura de disciplina" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="c644-7aa0-249c-5ebe" publicationId="46cd-a15f-f8aa-0899" page="32">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cualquier unidad aliada a 15 cm. de un Comisario Mayor puede utilizar su valor de Liderazgo 10 para cualquier chequeo de Moral o de Acobardamiento, así como para los chequeos de Liderazgo que se realicen para recibir órdenes.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ejecucion sumaria" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="afcc-188c-2d40-2612" publicationId="46cd-a15f-f8aa-0899" page="32">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si la unidad del comisario falla un chequeo de moral el Comisario ejecutara de modo sumarísimo al comandante actual de la unidad; es decir, la miniatura de la unidad con el mayor valor de Liderazgo.


Si dos o más miniaturas en la misma escuadra del Comisario tienen el mismo valor de Liderazgo, determina al azar qué miniatura es ejecutada. Un comisario (de cualquier graduación) nunca se ejecutaría ni a si mismo ni a ningún otro comisario (de cualquier graduación). Ignora a estas miniaturas al determinar los candidatos a ser ejecutados.


La miniatura ejecutada se retira inmediatamente como baja, independientemente del número de Heridas que le quedasen. En este momento la unidad volverá a tirar su chequeo de moral, si este chequeo falla de nuevo entonces la unidad se retirará de modo normal.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola láser Sobrecargada" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="93ae-a3e4-0432-d82f">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">15cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">3</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistola</characteristic>
      </characteristics>
    </profile>
    <profile name="Desgarrador" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="afa6-4c94-0745-8322" publicationId="46cd-a15f-f8aa-0899" page="35">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un desgarrador es una enorme espada sierra a dos manos capaz de inflingir terribles daños sobre seres vivos o vehículos.

Un desgarrador cuenta como un puño de combate, pero añade 1D6 a la penetración de blindaje.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rosarius" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="2fb1-8e6f-8942-ae00" publicationId="46cd-a15f-f8aa-0899" page="35">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un Rosarius es un emblema de fe que incorpora un poderoso campo de conversión que protege a su portador del peligro.
El Rosarius proporciona una tirada de salvación invulnerable de 4+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Servobrazo" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="93d1-9419-dcbb-921d" publicationId="46cd-a15f-f8aa-0899" page="34">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un Servobrazo proporciona un ataque Cuerpo a cuerpo adicional que impacta con Iniciativa 1, Fuerza 8 e ignora la Salvación por armadura.</characteristic>
      </characteristics>
    </profile>
    <profile name="Servoarmadura" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="6000-c4d9-20e4-ca94" publicationId="46cd-a15f-f8aa-0899" page="71">
      <characteristics>
        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas equipadas con una servoarmadura tienen una salvación por armadura de 3+</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
