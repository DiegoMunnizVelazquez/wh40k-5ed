    <infoGroup name="Comisario Mayor" id="1d2ceaaf-f740-4bfb-8637-3b13f356e32b" hidden="false">
      <infoLinks>
        <infoLink name="Comisario Mayor" id="6c0b8e27-6c1a-43e1-a9a6-304416021c9a" hidden="false" targetId="6020767f-73ab-44be" type="profile"/>
        <infoLink name="Testarudos" id="d424-aa37-31d6-7ada" hidden="false" targetId="6238-4e29-b780-4b11" type="rule"/>
        <infoLink name="Aura de disciplina" id="12b0-ab6a-ae3b-36ac" hidden="false" targetId="c644-7aa0-249c-5ebe" type="profile"/>
