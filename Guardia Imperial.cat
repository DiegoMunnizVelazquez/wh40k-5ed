    <infoGroup name="Mantícora" id="e99df5fe-e3b3-473f-a9df-9df545233228" hidden="false">
      <infoLinks>
        <infoLink name="Mantícora" id="f5a0f837-412c-4990-92f3-86af3a4efb22" hidden="false" targetId="2765-b92f-6ed9-20bd" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Munición limitada" id="182d-6738-bc9f-68d3" hidden="false" page="54" publicationId="46cd-a15f-f8aa-0899" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El lanzacohetes Mantícora normalmente cuenta con espacio para cuatro cohetes. Cuenta cada vez que dispares un misil. Una vez hayas disparado tu cuarto misil se habrá terminado la munición. No puede re-armarse y en consecuencia no podrá volver a disparar en esta partida. Ten en cuenta que un Lanzamisiles Mantícora sólo podrá dispara un único cohete cada turno.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </infoGroup>
