            <infoLink name="Moverse a Través de Cobertura" id="e261-7f29-e8bd-3946" hidden="false" targetId="6cf1-d139-8b14-6083" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Diablos de Catachán" id="d56e-0164-8491-82ba" hidden="false" page="62" publicationId="46cd-a15f-f8aa-0899" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Harker y su escuadrón tienen las reglas especiales Infiltración, Sigilo y Moverse a través de cobertura.</characteristic>
