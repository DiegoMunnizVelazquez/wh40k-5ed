    <selectionEntry name="Noble comandante Pask" id="48e8-e9d8-a553-ba21" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="cd3a-9b44-e59d-ff5c" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
