        <infoLink name="Personaje independiente" id="9073-bedb-d924-cbe7" hidden="false" type="rule" targetId="61b4-c5bb-9d85-8506"/>
        <infoLink name="Unidad retropropulsada" id="f487-d97e-73c3-75fc" hidden="false" type="infoGroup" targetId="9cdf-bda3-6dab-3a27"/>
        <infoLink name="Coraje" id="244a-9c85-7c2b-0b86" hidden="false" type="rule" targetId="b23b-fb5c-4c8c-5ae4"/>
        <infoLink name="Escudo de Fe" id="8de8-cac3-4e3a-baa7" hidden="false" type="rule" targetId="2b86-8280-f5aa-91c1"/>
        <infoLink name="Granadas Perforantes" id="471f-27c9-1fbd-1bc6" hidden="false" type="infoGroup" targetId="5013-1b13-3fea-2166"/>
        <infoLink name="Granadas de asalto" id="b227-44dd-0d63-eec3" hidden="false" type="infoGroup" targetId="a9de-5c4c-d2c8-6676"/>
      </infoLinks>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="32d3-5d3a-434e-c465" includeChildSelections="true"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="115"/>
      </costs>
      <profiles>
        <profile name="Intervención milagrosa" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="db8d-6820-3a60-7f59">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cada vez que Celestine sea retirada como baja, sitúa un marcador para indicar el lugar donde &quot;murió&quot;. Tira 1D6 al inicio de cada uno de tus siguientes turnos. Si el resultado es 4+, sitúala a 3 cm del marcador con 1D3 heridas recuperadas. Si Celestine quedase a 3 cm o menos de otra miniatura, muévela la menor distancia posible para que no esté a 3 cm.
Celestine puede actuar normalmente en el turno en que &quot;resucita&quot;. Celestine no proporciona puntos al enemigo si está viva sobre el campo de batalla al término de la partida.</characteristic>
          </characteristics>
        </profile>
        <profile name="Armadura de Santa Katherine" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="6b6b-3f58-11a3-66e7">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La armadura de Santa Katherine confiere a su portador una salvación por armadura de 2+ y una salvación invulnerable de 4+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoGroups>
        <infoGroup name="La Espada flamígera" id="e3cd-e954-bea6-d897" hidden="false">
          <profiles>
            <profile name="La Espada flamígera" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="a291-a4bc-9fa0-974e">
              <characteristics>
                <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">La Espada flamígera: este arma de energía siempre hiere a los enemigos con un resultado de 4+ (a menos que baste con una tirada mas baja). Además, puede disparar en la fase de Disparo</characteristic>
              </characteristics>
            </profile>
            <profile name="La Espada flamígera" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="2fc2-4621-5b78-cb50">
              <characteristics>
                <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Plantilla</characteristic>
                <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
                <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
                <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Energía" id="f52d-68d7-9746-de56" hidden="false" type="rule" targetId="2528-3f58-a823-5b4a"/>
            <infoLink name="Plantilla" id="0c65-cbcc-b463-d3c1" hidden="false" type="rule" targetId="d094-3fd7-bd10-443d"/>
          </infoLinks>
        </infoGroup>
