        <infoGroup name="Maza de Valaan" id="3433-8817-6ca2-3a12" hidden="false">
          <profiles>
            <profile name="Maza de Valaan" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="7480-32e1-6182-f95a">
              <characteristics>
                <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">La maza de Valaan es un arma de energía. Además, toda miniatura que sufra una herida no salvada de la Maza de Valaan reduce su Iniciativa a 1 hasta el término del siguiente turno del jugador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Energía" id="996f-ed9d-140e-7463" hidden="false" type="rule" targetId="2528-3f58-a823-5b4a"/>
