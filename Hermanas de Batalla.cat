      <rules>
        <rule name="Shock Psíquico" id="74c4-04cf-04fb-f8d7" hidden="false">
          <description>Cualquier psíquico que sufra una herida no salvada del disparo de la ballesta de estacas sufrirá los Peligros de la Disformidad, además de cualquier otro efecto.</description>
        </rule>
      </rules>
      <profiles>
        <profile name="Bólter condenación" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="c7b8-c806-66c8-0d91">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El Bólter condenación sigue las reglas de las combiarmas, compuesto por un Bólter y un armazón de ballesta de un solo disparo</characteristic>
          </characteristics>
        </profile>
      </profiles>
