        <infoGroup name="Icono de Chiros" id="ec4f-673a-b99e-64f6" hidden="false">
          <profiles>
            <profile name="Icono de Chiros" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="7944-e813-6139-abdc">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Todas las unidades amigas que estén a una distancia de hasta 15 cm de Kyrinov están sujetas a la regla especial Coraje.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
