          </conditions>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Suprema Presencia Inspiradora" hidden="false" id="5298-d052-6330-7e74" sortIndex="3">
          <profiles>
            <profile name="Suprema Presencia Inspiradora" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="db62-73b8-fd3e-9aaf" publicationId="21fd-62c1-d9f7-e743" page="42">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los etéreos y todas las unidades tau (ni Kroot ni Véspides ni drones) se consideran testarudos si Aun&apos;va está en su campo de visión. En caso de que se esté aplicando la regla especial combate nocturno, efectúa una tirada de dados de la forma habitual para determinar si la unidad puede ver al etéreo o no.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="2498-2dc3-4b74-da88-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2498-2dc3-4b74-da88-max" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Paradoja de la Dualidad" hidden="false" id="d1c5-8a22-4f08-ac97" sortIndex="2">
          <profiles>
            <profile name="Paradoja de la Dualidad" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="508b-cd95-572f-756c" publicationId="21fd-62c1-d9f7-e743" page="42">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Otorga a Aun&apos;va y a su guardia de honor la Resistencia que va entre paréntesis en el perfil, el valor sin modificar es el que hay que aplicar para la muerte instantánea. También les otorga una salvación por cobertura de 4+ que puede repetirse en caso de fallarse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="7211-248c-db6a-918c-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="7211-248c-db6a-918c-max" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Guardias de Honor" hidden="false" id="feea-778a-5502-b595" sortIndex="5">
          <constraints>
            <constraint type="min" value="2" field="selections" scope="parent" shared="true" id="7ba4-a88e-ec3e-7de8-min" includeChildSelections="false"/>
            <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="7ba4-a88e-ec3e-7de8-max" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Guardia de Honor" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad" hidden="false" id="9382-9af5-950a-24c3" publicationId="21fd-62c1-d9f7-e743" page="42">
              <characteristics>
                <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Personaje Infantería</characteristic>
                <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic>
                <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
                <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3(5)</characteristic>
                <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3(5)</characteristic>
                <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
                <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">3</characteristic>
