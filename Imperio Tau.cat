              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink import="true" name="Lanza de los Desafios" hidden="false" id="123b-d22c-4768-61ec" type="selectionEntry" targetId="440e-6dc8-da43-f8db">
              <constraints>
                <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="d325-89cf-1aaf-2875-min" includeChildSelections="false"/>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d325-89cf-1aaf-2875-max" includeChildSelections="false"/>
              </constraints>
            </entryLink>
          </entryLinks>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="El Supremo Precio del Fracaso" hidden="false" id="64bd-5557-cca4-8baf" sortIndex="4">
          <profiles>
            <profile name="El Supremo Precio del Fracaso" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="e09b-6791-e249-288b" publicationId="21fd-62c1-d9f7-e743" page="42">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si un Aun&apos;va es destruido, todas las unidades tau en el tablero de juego (ni Kroot ni Véspides ni drones) deben superar un chequeo de moral al inicio del siguiente turno si no están trabadas en combate o se están batiendo en ¡Retirada! Toda unidad tau que lleve a cabo este chequeo se beneficiará de la regla especial Enemigo Predilecto (el enemigo se considera el &quot;Enemigo Predilecto&quot;) y Asalto Rabioso tanto si supera el chequeo como si no y los efectos duran hasta el final de la partida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="df9f-336c-d53f-7f16-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df9f-336c-d53f-7f16-max" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="model" import="true" name="Aun&apos;va" hidden="false" id="b2a4-6e0a-bd4f-ad79" sortIndex="1">
          <profiles>
