        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">30cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistola</characteristic>
      </characteristics>
    </profile>
    <profile name="Rifle Acelerador" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="a3ff-5a33-f08a-7ac1" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">90cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pesada 1, Acobardamiento</characteristic>
      </characteristics>
    </profile>
    <profile name="Rifle de Inducción" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="c2dc-f477-6420-941b" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">75cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Fuego Rápido</characteristic>
      </characteristics>
    </profile>
    <profile name="Rifle de Plasma" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="de39-5b0f-d695-9bb5" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Fuego Rápido</characteristic>
      </characteristics>
    </profile>
    <profile name="Rifle Kroot" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="58e0-1395-a1cf-48ac" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">6</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Fuego Rápido*</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema de Misiles Inteligentes" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="558b-44d6-d9ec-ae22" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pesada 4*</characteristic>
      </characteristics>
    </profile>
    <profile name="Cicloblaster Iónico" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="48d8-b0c9-9362-a324" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">3</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 5*</characteristic>
      </characteristics>
    </profile>
    <profile name="Eyector de Minas Aéreas" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="6029-3841-8117-64f0">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Barrera de Artillería</characteristic>
      </characteristics>
    </profile>
    <profile name="Controlador de Drones" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="00b6-d74b-4090-54e8" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura con este elemento de equipo puede elegir, de la lista de sistemas complementarios para armaduras, entre uno y dos drones de combate, de defensa o telemétricos, en la combinación que prefiera.</characteristic>
      </characteristics>
    </profile>
    <profile name="Faro Posicional" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="692a-f893-78c1-6161" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A partir del segundo turno, siempre y cuando el portador del faro posicional esté en el tablero de juego al principio del turno en el que se utilice este aparato, una unidad de las que se mantienen en la reserva podrá ser desplegada sobre el tablero con un resultado de 2+; aunque, en tal caso, en ese mismo turno no se podrá desplegar ninguna otra unidad de la reserva.</characteristic>
      </characteristics>
    </profile>
    <profile name="Filtro de Visión Nocturna" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="3ea4-8385-518a-078f" publicationId="21fd-62c1-d9f7-e743" page="26/30">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este filtro óptico avanzado permite ver hasta el doble del resultado obtenido en los dados a la hora de determinar la distancia que puede ver una miniatura durante un combate nocturno.
Solo las miniaturas equipadas con el filtro de visión nocturna se benefician de esta ventaja; por ejemplo, si el líder de un grupo de armaduras de combate Apocalipsis se equipa con el filtro de visión nocturna y el resto de su grupo no, solo el líder disparará a distancias mayores de los habituales 2D6 x 3 cm.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ordenador de Combate" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="1ec8-87b0-2375-8a70" publicationId="21fd-62c1-d9f7-e743" page="26/31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Suma +1 a la HP de quien lo utiliza (hasta un máximo de 5HP)</characteristic>
      </characteristics>
    </profile>
    <profile name="Generador de Escudo" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="e809-e763-fdde-9351" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Proporciona al portador una tirada de Salvación Invulnerable de 4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Retrocohetes Vectoriales" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="fd39-e93d-5c34-0bd9" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La miniatura se beneficia de la regla especial universal atacar y huir. Solo pueden equiparse con estos retrocohetes los personajes independientes y las miniaturas que componen equipos de una sola miniatura (&apos;Monats&apos;) siempre que no lleven drones.</characteristic>
      </characteristics>
    </profile>
    <profile name="Selector de Objetivo" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="0d1f-0137-691d-709c" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este especializado selector de objetivos permite a la miniatura que lo posee disparar a una unidad objetivo enemiga diferente a la que ha disparado el resto de su unidad.
Todos los disparos de la unidad deben declararse antes de que se lance ningún dado.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema de Disparo Múltiple (SDM)" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="188f-6b0e-42f7-acdb" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Permite a la miniatura disparar dos sistemas de armamento para armaduras en el mismo turno.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema Giroestabilizador Avanzando" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="4e9a-654d-4650-f151" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">En la fase de movimiento, la armadura puede decidir utilizar la regla especial avance sistemático durante el resto del turno. En este caso, no podrá hacer un movimiento retropropulsado adicional durante la fase de asalto.
Si una de las miniaturas del equipo dispone de este sistema, todas las demás miniaturas del equipo deberán tenerlo también. Además, si una de las miniaturas hace uso del sistema, las demás también tendrán que hacer uso de él.
La unidad puede equiparse con drones.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura Mimética" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="863e-afb5-7121-3273" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de un traje diseñado para la infiltración. Los miembros de los equipos de armaduras miméticas se consideran unidades retropropulsadas sujetas a las reglas de retrocohetes.
Los portadores de estas armaduras y los drones de que dispongan pueden ser desplegados de acuerdo con las reglas de despliegue rápido siempre que la misión lo permita (aunque no podrán llevar a cabo el movimiento adicional de 15 cm en el turno en que lleguen). Además, los sensores avanzados de esta armadura proporcionan a su portador la regla especial sentidos aguzados.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura XV8 Crisis" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="eec7-d8bc-9e56-251b" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los miembros de los equipos de armaduras Crisis se consideran unidades retropropulsadas sujetas a las reglas de retrocohetes.
Los portadores de estas armaduras y los drones de que dispongan pueden ser desplegados de acuerdo con las reglas de despliegue rápido siempre que la misión lo permita (aunque no podrán llevar a cabo el movimiento adicional de 15 cm en el turno en que llegan). Además, los sensores avanzados de esta armadura proporcionan a su portador la regla especial sentidos aguzados.
Estas armaduras están diseñadas para compensar el retroceso de las armas ligeras, por lo que no se considera que hayan movido cuando disparan armas de fuego rápido. Esta habilidad no es extensible a las armas pesadas, por lo que las armaduras deberán permanecer estacionarias para disparar estas armas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura XV88 Apocalipsis" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="d71c-3e6c-2306-3ec9" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de una variante más robusta de la armadura Crisis, cuyos sensores avanzados le proporcionan a su portador la regla especial sentidos aguzados. No se considera que las armaduras hayan movido cuando disparan armas de fuego rápido. Esta habilidad no es extensible a las armas pesadas, por lo que las armaduras deberán permanecer estacionarias para disparar estas armas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Autodestrucción" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="e4f9-8638-e005-af4a" publicationId="21fd-62c1-d9f7-e743" page="25">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El sistema de autodestrucción puede dispararse si su portador es parte de un equipo que se vea forzado a retirarse tras perder un asalto.


El equipo se mueve de la forma normal, pero la miniatura con el sistema de autodestrucción permanece quieta y el enemigo no podrá efectuar una persecución arrolladora. Despues de que se haya movido su equipo y antes de que se lleven a cabo los movimientos de unirse
al combate, la miniatura activa el detonador: coloca la plantilla de área de efecto grande centrada sobre la miniatura y haz las tiradas por impactos de la manera habitual. Las miniaturas impactadas sufrirán 1 impacto de F8 y FP -. Retira como una baja la miniatura que ha detonado el sistema. El enemigo no puede consolidar la posición. Ten en cuenta que la unidad enemiga no tiene que efectuar chequeo de moral alguno en caso de que este ataque cause un 25% de bajas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Blindaje de Iridio" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="9241-aa10-eaf3-df8f" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este elemento de equipo aumenta la tirada de salvación por armadura de la miniatura a 2+, pero, en vez de los 15 cm adicionales de movimiento durante la fase de asalto, la miniatura deberá tirar 1D6 y moverá en función del resultado obtenido: 1=3 cm; 2=5 cm; 3=8 cm; 4=10 cm; 5=12 cm; 6=15 cm.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cuchillo Ta&apos;lissera" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="6019-6b55-3662-24a0" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Mientras el portador del cuchillo esté vivo, la unidad con este vínculo puede reagruparse siempre, incluso si se encuentra por debajo de la mitad de efectivos. Los portadores de armaduras de combate no necesitan llevar el cuchillo; basta con que lleven su diseño pintado sobre la armadura.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema de Eyección" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="1547-dbcc-144b-9657" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">En caso de que la miniatura pierda su última herida por culpa de un ataque de disparo que no le cause una muerte instantánea, reemplaza la armadura por una única miniatura, que representará al piloto. El perfil de atributos de esta miniatura es igual que el de la armadura, pero con las siguientes modificaciones: Fuerza -2, Resistencia -1; solamente tendrá 1 Herida y no tendrá tirada de salvación por armadura. La miniatura estará equipada, únicamente, con una pistola de inducción. Solo pueden equiparse con sistemas de eyección los personajes independientes y las miniaturas que componen equipos de una sola miniatura (&apos;Monats&apos;) siempre que no lleven drones.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema de Soporte Vital (SSV)" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="e0b3-10b1-b6c6-d8f5" publicationId="21fd-62c1-d9f7-e743" page="27">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La miniatura gana la regla especial ¡No Hay Dolor!</characteristic>
      </characteristics>
    </profile>
    <profile name="Lanza de los Desafios" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="021b-24d4-6e27-fadf" publicationId="21fd-62c1-d9f7-e743" page="29">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Es un arma a dos manos, por lo que no se considerará que el portador lleve un arma adicional. Suma +2 a la Fuerza de su portador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Granadas IEM" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="f52b-7e84-e501-68d1" publicationId="21fd-62c1-d9f7-e743" page="29">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Al asaltar vehículos, estas granadas causarán un impacto superficial con un resultado de 4 o 5 al penetrar el blindaje y un impacto interno con un resultado de 6</characteristic>
      </characteristics>
    </profile>
    <profile name="Presencia Inspiradora" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="6432-fbe5-92b2-08b0" publicationId="21fd-62c1-d9f7-e743" page="33">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los etéreos y todas las unidades tau (ni Kroot ni Véspides ni drones) pueden repetir cualquier chequeo de moral si hay un etéreo en su campo de visión. En caso de que se esté aplicando la regla especial combate nocturno, efectúa una tirada de dados de la forma habitual para determinar si la unidad puede ver al etéreo o no.
Esto incluye los chequeos de moral superados. El segundo resultado es el que prevalece. La unidad tau en la que se encuentre el etéreo pasa a tener la regla especial coraje.</characteristic>
      </characteristics>
    </profile>
    <profile name="El precio del fracaso" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="bbf9-1a71-c914-3b8e" publicationId="21fd-62c1-d9f7-e743" page="33">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si un etéreo es destruido, todas las unidades tau en el tablero de juego (ni Kroot ni Véspides ni drones) deben superar un chequeo de moral al inicio del siguiente turno si no están trabadas en combate o se están batiendo en ¡Retirada! Toda unidad tau que lleve a cabo este chequeo se beneficiará de la regla especial Enemigo Predilecto (el enemigo se considera el &quot;Enemigo Predilecto&quot;) tanto si supera el chequeo como si no y los efectos duran hasta el final de la partida.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shas&apos;ui Crisis" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad" hidden="false" id="f4d2-71d6-2f1b-a26a" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería (Retropropulsada, Retrocohetes)</characteristic>
        <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">2</characteristic>
        <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
        <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">5</characteristic>
        <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
        <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic>
        <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
        <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Proyector de Campo Mimético" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="8928-072c-5cb4-9dcf" publicationId="21fd-62c1-d9f7-e743" page="26">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas enemigas que intenten disparar a una unidad cuyos integrantes estén todos equipados con proyectores de campo mimético tendrán que averiguar su distancia de detección con una tirada de 5D6 x 3cm (como si dispararan de noche). Si las miniaturas equipadas con este elemento de equipo no se encuentran dentro de ese radio, el enemigo no los podrá elegir como objetivo y tendrá que disparar a otro objetivo. Se considera que las miniaturas equipadas con este elemento están a cubierto si son asaltadas. Estas miniaturas no obtienen beneficios adicionales cuando se aplican las reglas de combate nocturno. Las armas de artillería tiran 3D6 adicionales a la hora de determinar la distancia en centímetros que se dispersan sus disparos contra estas miniaturas. Los drones controlados por una miniatura con un proyector de campo mimético también estarán protegidos por el proyector sin coste adicional en puntos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Granadas Fotónicas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="689a-32c1-b4af-6066" publicationId="21fd-62c1-d9f7-e743" page="29">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas que carguen contra unidades equipadas con granadas fotónicas no obtienen ataques de bonificación por cargar, aunque sí que se benefician de los ataques cuerpo a cuerpo especiales de los que dispongan por cargar.</characteristic>
      </characteristics>
    </profile>
    <profile name="Multisensores" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="eb66-4a01-ce8e-d7e8" publicationId="21fd-62c1-d9f7-e743" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El vehículo puede decidir utilizarlos en vez de mover de la manera normal. En caso de hacerlo, el vehículo no podrá estar gravitando sobre ningún elemento de escenografía; de hecho, se considera que está avanzando a través de él. De esta forma, el vehículo se considerará un objetivo desenfilado como cualquier otro vehículo en la misma posición; la única diferencia es que los sensores le permiten evitar los efectos del terreno peligroso.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema de Disparo Múltiple (SDM)" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="e842-5909-71f1-c058" publicationId="21fd-62c1-d9f7-e743" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Permite a un vehículo disparar como si fuera un vehículo rápido</characteristic>
      </characteristics>
      <comment>Vehículos</comment>
    </profile>
    <profile name="Selector de Objetivo" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="5beb-b50e-dd43-0cbb" publicationId="21fd-62c1-d9f7-e743" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cada arma del vehículo puede abrir fuego sobre una unidad enemiga diferente si así prefiere</characteristic>
      </characteristics>
      <comment>Vehículo</comment>
    </profile>
    <profile name="Descargador de Agujas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="2b87-e7f4-aca4-a0ea" publicationId="21fd-62c1-d9f7-e743" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si una miniatura enemiga ataca al vehículo en combate cuerpo a cuerpo, será herida si obtiene un resultado de 4+ en una tirada de 1D6 (Se permiten tiradas de salvación) que hará antes de realizar los ataques.</characteristic>
      </characteristics>
    </profile>
    <profile name="Módulo Distorsionador" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="df80-6692-f261-1ca6" publicationId="21fd-62c1-d9f7-e743" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Para las unidades que le disparen a una distancia mayor a 30cm, el vehículo se considera desenfilado.</characteristic>
      </characteristics>
    </profile>
    <profile name="Lanzadores de Señuelos" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="a882-13b2-f087-4976" publicationId="21fd-62c1-d9f7-e743" page="30">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cuando el vehículo sufra un resultado de inmovilizado, el jugador TAU puede obligar a repetir la tirada, pero deberá aceptar este segundo resultado.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tren de Aterrizaje" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="651c-0fc4-2a91-4f2e" publicationId="21fd-62c1-d9f7-e743" page="31">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">En cualquiera de los turnos en los que el vehículo no se mueva, puede elegir no ser considerado como gravitatorio hasta que vuelva a moverse. Este beneficio no es aplicable en el primer turno.</characteristic>
      </characteristics>
    </profile>
    <profile name="Aborígenes" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="bd6a-9e08-fabc-79e1" publicationId="21fd-62c1-d9f7-e743" page="37">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los Kroot suman +1 a su tirada de salvación por cobertura si están en un bosque o en una jungla y en esos terrenos tampoco han de efectuar ningún chequeo por terreno difícil (siempre pueden mover hasta 15 cm).</characteristic>
      </characteristics>
    </profile>
    <profile name="Infiltración" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="10d0-0f0f-5ef1-5f78" publicationId="21fd-62c1-d9f7-e743" page="37">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si la escuadra no incluye ningún krootox, puede infiltrarse siempre que la misión lo permita.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shas&apos;la Rastreador" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad" hidden="false" id="7be6-f038-c321-2f50" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería</characteristic>
        <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">2</characteristic>
        <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
        <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic>
        <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3</characteristic>
        <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic>
        <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">7</characteristic>
        <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Shas&apos;ui Rastreador" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad" hidden="false" id="9afb-1b72-5fc8-a8e9" publicationId="21fd-62c1-d9f7-e743">
      <characteristics>
        <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería</characteristic>
        <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">2</characteristic>
        <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
        <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic>
        <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3</characteristic>
        <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic>
        <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
        <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Rastreador Telemétrico" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="b7e3-3cc1-8129-a9be" publicationId="21fd-62c1-d9f7-e743" page="38">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las unidades tau que desplieguen de acuerdo con la regla especial despliegue rápido en un punto que se encuentre dentro del campo de visión del Mantarraya de los rastreadores podrán repetir la tirada de dispersión. Ten en cuenta que el Mantarraya tiene que estar desplegado sobre el tablero de juego para que se pueda utilizar el rastreador telemétrico.</characteristic>
      </characteristics>
    </profile>
    <profile name="Drones de Combate Montados" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="18e0-9ac9-4e96-8518">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los drones se mueven con el vehículo, bien protegidos en unos compartimentos especialmente diseñados para ellos. Durante cualquier fase de movimiento tau, los drones pueden desembarcar del vehículo y formar una unidad independiente como lo haría una unidad normal desembarcando de un transporte. A partir de este momento, actúan como un escuadrón de drones y no podrán volver a incorporarse al vehículo durante la partida. Nunca se consideran una unidad que puntúa. Mientras son transportados por el vehículo, los drones pueden disparar, utilizando su propia HP, como un añadido a cualquier otra arma que el vehículo pudiera disparar normalmente. Los drones se consideran pasajeros en caso de que el vehículo sea dañado.</characteristic>
      </characteristics>
    </profile>
    <profile name="Red Telemétrica" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="1707-7088-c6de-dc00" publicationId="21fd-62c1-d9f7-e743" page="29">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Funciona igual que los marcadores telemétricos con la diferencia de que la unidad a la que pertenece puede gastar los contadores que se pusieron con la propia Red Telemétrica.</characteristic>
      </characteristics>
    </profile>
    <profile name="Voladores Consumados" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="fd4f-7441-68e5-f7d5" publicationId="21fd-62c1-d9f7-e743" page="39">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los Véspides pueden repetir los chequeos por terreno peligroso fallidos</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
