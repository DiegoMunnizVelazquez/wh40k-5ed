    <selectionEntry id="9669-972c-586c-5be9" name="Khârn el Traidor" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a9ee-e94f-9a1e-40aa" type="max"/>
      </constraints>
      <profiles>
        <profile id="69f9-38b0-68f4-4944" name="El Traidor" publicationId="f744-f28b-4145-1729" page="48" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cualquier tirada para impactar de Khârn en combate cuerpo a cuerpo que obtenga un resultado de 1 se considerará un impacto en su propio bando. Resuelve los impactos en la unidad amiga más próxima elegida al azar y que también esté trabada en el mismo combate, como si hubiese sido impactada por el enemigo; para ello, usa el perfil de atributos y armas de Khârn. Si no hay más unidades amigas trabadas en el mismo combate que Khârn, los ataques se pierden.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="1aab-fda2-40c3-4e49" publicationId="f744-f28b-4145-1729" page="48">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Khârn tiene una tirada de salvación Invulnerable de 5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Bendición del Dios de la Sangre" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="89ba-d473-4c07-f0b7" publicationId="f744-f28b-4145-1729" page="48">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Khârn es inmune a los efectos de los poderes psíquicos; además, las armas psíquicas se consideran armas normales si se utilizan contra él.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="5447-38f9-654f-261f" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="43fe-0499-7531-8ac2" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="Khârn" id="6ac4-4fdd-29fe-edad" hidden="false" type="profile" targetId="8623-ef01-9689-8f53"/>
        <infoLink name="Granadas Perforantes y de Fragmentación" id="b8fa-a2a5-0d03-23d0" hidden="false" type="infoGroup" targetId="795b-704d-ab71-04cc"/>
        <infoLink name="Asalto Rabioso" id="e6f0-46be-4ec0-922a" hidden="false" type="rule" targetId="33b4-1a73-92db-e562"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="2183-8e88-a6cb-ed06" name="Destripadora" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="c070-2956-f671-58d3" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6c2d-08a5-79f7-e882" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Destripadora" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="0795-5352-5441-257a" publicationId="f744-f28b-4145-1729" page="48">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los ataques de Khârn en combate cuerpo a cuerpo siempre impactan con un resultado de 2+. Además, Destripadora cuenta como un arma de energía y cuando impacta en vehículos suma 1D6 a la tirada de penetración de armadura de Khârn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Energía" id="203c-c850-0b15-57ed" hidden="false" type="rule" targetId="2528-3f58-a823-5b4a"/>
          </infoLinks>
          <costs>
            <cost name="Pts" typeId="puntos" value="0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
