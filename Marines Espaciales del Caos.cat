      <infoLinks>
        <infoLink name="Personaje independiente" id="5447-38f9-654f-261f" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink name="Coraje" id="43fe-0499-7531-8ac2" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="Khârn" id="6ac4-4fdd-29fe-edad" hidden="false" targetId="8623-ef01-9689-8f53" type="profile"/>
        <infoLink name="Granadas Perforantes y de Fragmentación" id="b8fa-a2a5-0d03-23d0" hidden="false" targetId="795b-704d-ab71-04cc" type="infoGroup"/>
        <infoLink name="Asalto Rabioso" id="e6f0-46be-4ec0-922a" hidden="false" targetId="33b4-1a73-92db-e562" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="El Traidor" id="69f9-38b0-68f4-4944" hidden="false" page="48" publicationId="f744-f28b-4145-1729" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cualquier tirada para impactar de Khârn en combate cuerpo a cuerpo que obtenga un resultado de 1 se considerará un impacto en su propio bando. Resuelve los impactos en la unidad amiga más próxima elegida al azar y que también esté trabada en el mismo combate, como si hubiese sido impactada por el enemigo; para ello, usa el perfil de atributos y armas de Khârn. Si no hay más unidades amigas trabadas en el mismo combate que Khârn, los ataques se pierden.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable" id="1aab-fda2-40c3-4e49" hidden="false" page="48" publicationId="f744-f28b-4145-1729" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Khârn tiene una tirada de salvación Invulnerable de 5+</characteristic>
          </characteristics>
        </profile>
        <profile name="Bendición del Dios de la Sangre" id="89ba-d473-4c07-f0b7" hidden="false" page="48" publicationId="f744-f28b-4145-1729" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Khârn es inmune a los efectos de los poderes psíquicos; además, las armas psíquicas se consideran armas normales si se utilizan contra él.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Destripadora" id="2183-8e88-a6cb-ed06" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c070-2956-f671-58d3" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="6c2d-08a5-79f7-e882" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
