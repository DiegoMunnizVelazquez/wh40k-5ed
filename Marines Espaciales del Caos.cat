            <cost name="Pts" typeId="puntos" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Energía" id="203c-c850-0b15-57ed" hidden="false" targetId="2528-3f58-a823-5b4a" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Destripadora" id="0795-5352-5441-257a" hidden="false" page="48" publicationId="f744-f28b-4145-1729" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los ataques de Khârn en combate cuerpo a cuerpo siempre impactan con un resultado de 2+. Además, Destripadora cuenta como un arma de energía y cuando impacta en vehículos suma 1D6 a la tirada de penetración de armadura de Khârn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
