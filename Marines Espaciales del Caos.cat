            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="f295-2a54-7b28-b05a-max" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Armadura de las Almas Aullantes" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="06c8-0c37-78e7-93ae" publicationId="f744-f28b-4145-1729" page="54">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cada tirada de salvación por armadura o invulnerable que Lucius supere en combate cuerpo a cuerpo causará un impacto de Fuerza 4 sin posibilidad de tirada de salvación por armadura a la unidad que trataba de causarle la herida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
