    <selectionEntry id="0740-08b3-937c-fb73" name="Ahriman" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bb0d-5422-f640-46ae" type="max"/>
      </constraints>
      <profiles>
        <profile id="ef32-aada-fdcb-c19d" name="Maestro de la hechicería" publicationId="f744-f28b-4145-1729" page="51" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Ahriman dispone de los poderes psíquicos siguientes: Rayo de la Condenación, Distorsión Temporal, Viento del Caos, Regalo del Caos, Rayo de la Transformación.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="3f99-6dbb-8639-64ad" publicationId="f744-f28b-4145-1729" page="51">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Ahriman tiene una tirada de salvación Invulnerable de 4+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Psíquico" id="5296-9c08-04ae-f7af" hidden="false">
          <description>La miniatura se considera Psíquico</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="fb19-13b1-ab4d-65f8" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="bd82-6afd-3e87-3e42" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
