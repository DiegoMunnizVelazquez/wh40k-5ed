        <profile name="Afinidad demoníaca" id="abda-a1fe-1ce1-2a77" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Al inicio de cada partida, una vez efectuado el despliegue, tira un dado en la tabla inferior. La unidad de Poseídos dispondrá de la regla especial o el equipo adicional que obtenga como resultado en la tabla durante toda la partida.


1D6 
1 - Exploradores
2 - Asalto rabioso
3 - Pies ligeros
4 - Armas aceradas
5 - ¡No hay dolor !
6 - Arma de energía</characteristic>
          </characteristics>
        </profile>
      </profiles>
