          </constraints>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Personaje independiente" id="cdde-2054-b009-4f87" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink name="Coraje" id="f875-335d-f0de-c773" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="Huron" id="1355-be9f-fb34-034f" hidden="false" targetId="df82-e71e-0327-261c" type="profile"/>
        <infoLink name="Granadas Perforantes y de Fragmentación" id="07aa-d6bc-8300-ac18" hidden="false" targetId="795b-704d-ab71-04cc" type="infoGroup"/>
        <infoLink name="Distorsión Temporal" id="03cb-bce8-13de-c1d7" hidden="false" targetId="faef-8a27-3911-217e" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Hamadrya" id="71ee-d5fc-476c-14a6" hidden="false" page="57" publicationId="f744-f28b-4145-1729" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Huron tiene una mascota de naturaleza desconocida a la que él llama su Hamadrya. La bestia parece semi inteligente y permanece al lado de Huron en todo momento, subida en su hombro o escondida tras él si las cosas se ponen muy feas. La criatura nunca lucha o trata de ayudar a
su maestro directamente, pero parece manifestar unos curiosos poderes psíquicos que Huron utiliza en su ventaja.


Hamadrya se considera un familiar, excepto que sus efectos convierten a Huron en un psíquico y le proporciona el poder psíquico Distorsión Temporal.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable" id="2ad9-d638-15c8-0372" hidden="false" page="57" publicationId="f744-f28b-4145-1729" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Huron tiene una tirada de salvación Invulnerable de 5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Psíquico" id="0042-7568-c460-6715" hidden="false">
          <description>La miniatura se considera Psíquico</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Garra del Tirano" id="bf0f-ba06-7230-f7eb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6513-4283-dcf0-b558-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="6513-4283-dcf0-b558-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Pts" typeId="puntos" value="0"/>
