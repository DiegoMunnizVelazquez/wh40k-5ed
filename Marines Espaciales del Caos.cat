    <selectionEntry id="1e0e-dc31-f1ae-8b8f" name="Abaddon el Saqueador" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ab3-2143-d38e-15f1" type="max"/>
      </constraints>
      <profiles>
        <profile name="La marca del Predilecto" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="2cc8-0211-70ef-f399" publicationId="f744-f28b-4145-1729" page="46">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Con el transcurso de los milenios, Abaddon ha asimilado todas las marcas del Caos que le han sido otorgadas y en la actualidad goza de una sola marca que combina todas las recompensas ganadas. La marca de Tzeentch hace que su tirada de salvación invulnerable sea de 4+. El resto de beneficios están incluidos en su perfil de atributos. Como la marca es prueba de que los Dioses del Caos tienen un plan para Abaddon, este es inmune a la regla especial Muerte Instantánea.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="67cb-c9a8-ffd3-15ba" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="d75d-77c1-d1a0-f625" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="Abaddon" id="e3ef-765e-6db5-4f5e" hidden="false" type="profile" targetId="f35e-98d0-7f3e-ccca"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="6bf9-0e59-be6c-5a3d" name="Espada demonio Drach&apos;nyen y Garra de Horus" hidden="false" collective="false" import="true" type="upgrade">
