        <infoLink name="Putrefacción de Nurgle (solo Nurgle)" id="fb80-cadd-c2c0-be61" hidden="false" targetId="02a8-0f73-9f48-fd79" type="profile"/>
        <infoLink name="Granadas de Plaga" id="d711-ffb6-aadb-f41a" hidden="false" targetId="819d-d10f-96d0-c80e" type="profile"/>
        <infoLink name="Granadas de asalto" id="20d5-aa40-1512-324b" hidden="false" targetId="a9de-5c4c-d2c8-6676" type="infoGroup"/>
