          <infoLinks>
            <infoLink name="Puño de Combate" id="0d2f-32f1-34f4-34ac" hidden="false" targetId="25b3-7b9d-199b-6d35" type="infoGroup"/>
            <infoLink name="Lanzallamas Pesado" id="c472-a642-5cca-bcab" hidden="false" targetId="37a7-0ae8-6e2b-1bb7" type="infoGroup"/>
          </infoLinks>
          <profiles>
            <profile name="Garra del Tirano" id="3f21-f2c0-39cd-3488" hidden="false" page="57" publicationId="f744-f28b-4145-1729" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La Garra del Tirano es un brazo biónico en forma de garra de oso que fue construido para reemplazar el propio brazo de Huron. La Garra es un puño de combate que lleva incorporado un lanzallamas pesado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
