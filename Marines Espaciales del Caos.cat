    <selectionEntry id="81a6-dc08-e9a0-29b8" name="Rifle de Plasma" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c120-21e4-3067-8ebb" type="max"/>
