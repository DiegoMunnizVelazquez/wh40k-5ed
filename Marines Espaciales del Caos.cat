        <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
        <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+</characteristic>
      </characteristics>
    </profile>
    <profile id="546b-bb23-6d02-3f3d" name="Sirena de Muerte" publicationId="f744-f28b-4145-1729" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" page="39">
