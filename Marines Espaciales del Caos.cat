          </costs>
          <infoLinks>
            <infoLink name="Arma Demonio" id="4022-950b-91a3-c5b6" hidden="false" targetId="0ccb-c3ab-d1fe-6792" type="infoGroup"/>
          </infoLinks>
          <profiles>
            <profile name="Espada demonio Drach&apos;nyen y Garra de Horus" id="cd31-9ffb-19c1-7418" hidden="false" page="46" publicationId="f744-f28b-4145-1729" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Con el transcurso de los milenios, Abaddon ha asimilado todas las marcas del Caos que le han sido otorgadas y en la actualidad goza de una sola marca que combina todas las recompensas ganadas. La marca de Tzeentch hace que su tirada de salvación invulnerable sea de 4+. El resto de beneficios están incluidos en su perfil de atributos. Como la marca es prueba de que los Dioses del Caos tienen un plan para Abaddon, este es inmune a la regla especial Muerte Instantánea.</characteristic>
              </characteristics>
            </profile>
          </profiles>
