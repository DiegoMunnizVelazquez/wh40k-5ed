      </characteristics>
    </profile>
    <profile name="Altavoz de letanía fúnebre" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="8bf5-31d4-523f-7714" publicationId="f744-f28b-4145-1729" page="87">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este dispositivo emite gritos y alaridos terrorificos para desmoralizar al enemigo. Cuando el vehículo efectúa una brutalidad acorazada, el enemigo sufre un modificador adicional de -1 a su Liderazgo.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
