    <selectionEntry id="717a-3e04-954f-996f" name="Fabius Bilis" publicationId="822e-763d-4a6a-b7fc" page="42" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="fe26-48d7-4afa-6df4" includeChildSelections="false"/>
      </constraints>
      <profiles>
        <profile name="El Cirujano" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="3f1d-2583-7f0e-0643" publicationId="f744-f28b-4145-1729" page="53">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de un complicado artefacto, mitad máquina tecnológica, mitad objeto mágico, que está conectado a la médula espinal de Bilis y que extiende sus miembros aracnoides por encima de sus hombros. El negro icor vital que el Cirujano bombea por el cuerpo de Bilis está cargado con la inmortal energia de la disformidad. Para representar sus efectos en combate, Fabius Bilis dispone de dos Ataques adicionales y un modificador de +1 a la Fuerza (incluidos en su perfil) y dispone además de la regla especial ¡No hay dolor!</characteristic>
          </characteristics>
        </profile>
        <profile name="Guerreros modificados" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="dac5-48a1-cb12-1643" publicationId="f744-f28b-4145-1729" page="53">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a Fabius Bilis en tu ejército, este puede modificar a alguno de los guerreros que se encuentren bajo su control mediante la manipulación genética y las drogas. Por un coste de +3 ptos por miniatura, cualquier número de escuadras de Marines Espaciales del Caos puede
&quot;modificarse&quot; con el tratamiento de Bilis. Sin embargo, los intentos de Fabius Bilis por mejorar a sus guerreros no siempre funcionan todo lo bien que cabría esperar. Al inicio de la batalla, cuando ambos bandos hayan desplegado pero antes del inicio del primer turno, tira 1D6 por cada escuadra modificada y consulta la tabla siguiente.


1D6 Resultado


1 - ¡Furia bersérker!: Los guerreros se atacan unos a otros con una furia desmedida. Efectúa una tirada de salvación por armadura por cada guerrero y retira a aquellos que no la superen. Los supervivientes están sujetos a coraje y suman +1 a su atributo de Fuerza durante el resto de la partida.


2-5 - Mutación estable: Esta vez los experimentos de Bilis han sido un éxito y los guerreros modificados están sujetos a coraje y suman +1 al atributo de Fuerza durante el resto de la partida.


6 - ¡Mi gran creación!: Las habilidades de cada guerrero se ven mejoradas hasta unos niveles sobrehumanos. Los guerreros están sujetos a coraje y suman +2 a su atributo de Fuerza durante toda la partida. Por desgracia, ni siquiera la constitución de
estos guerreros podrá aguantar este nivel de actuación durante mucho tiempo. Al término del turno de cada jugador, uno de los componentes de la escuadra será retirado como baja (la miniatura será elegida por el jugador del Caos).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="f4b1-c38d-4769-fc26" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="fc2a-cb11-56ee-9685" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="No Hay Dolor" id="377a-0394-f183-5f75" hidden="false" type="rule" targetId="fe28-c924-099d-aa4e"/>
        <infoLink name="Granadas Perforantes y de Fragmentación" id="1479-6c8e-4cf9-81f6" hidden="false" type="infoGroup" targetId="795b-704d-ab71-04cc"/>
        <infoLink name="Fabius Bilis" id="c601-ed32-ac0f-5841" hidden="false" type="profile" targetId="5b2e-ed2c-077d-ebe0"/>
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="puntos" value="160"/>
      </costs>
      <entryLinks>
        <entryLink import="true" name="Servoarmadura" hidden="false" id="6153-db79-a415-972e" type="selectionEntry" targetId="9657-fbb1-b1f9-5516"/>
        <entryLink import="true" name="Pistola Bolter" hidden="false" id="ad5e-2ac1-8700-8e23" type="selectionEntry" targetId="9f67-3f57-ebe8-1dbb">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="0e39-bd8c-dc71-2c92-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0e39-bd8c-dc71-2c92-max" includeChildSelections="false"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Inyector Xyclos" hidden="false" id="3a75-9b6e-4f66-94f7" publicationId="f744-f28b-4145-1729" page="53">
          <profiles>
            <profile name="Inyector Xyclos" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="db68-068e-bd47-cf16" publicationId="f744-f28b-4145-1729" page="53">
              <characteristics>
                <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45 cm</characteristic>
                <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">n/a</characteristic>
                <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">6</characteristic>
                <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 3</characteristic>
              </characteristics>
            </profile>
            <profile name="Inyector Xyclos" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="8ece-2434-5bfb-dc8c" publicationId="f744-f28b-4145-1729" page="53">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El arma no tiene atributo de Fuerza, puesto que siempre hiere con un resultado de 2+ en 1D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="db8b-bdc7-98b3-6473-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="db8b-bdc7-98b3-6473-max" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Báculo del Tormento" hidden="false" id="e84f-c14b-1963-57a0">
          <profiles>
            <profile name="Báculo del Tormento" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="5bd6-d060-63a5-a2e0" publicationId="f744-f28b-4145-1729" page="53">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El Báculo del Tormento se considera un arma de combate cuerpo a cuerpo. Cualquier enemigo que sufra una o más heridas del Báculo del Tormento quedará inmediatamente discapacitado por el dolor y sufrirá una muerte instantánea, independientemente de cuál fuera su Resistencia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="753f-8a21-6d23-01e4-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="753f-8a21-6d23-01e4-max" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="6aef-9466-2692-c242" name="Typhus" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4a1e-2051-d963-ab33" type="max"/>
      </constraints>
      <infoLinks>
        <infoLink id="23fa-03b0-56f9-15d6" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="f6db-12c8-f43f-ec1f" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="No Hay Dolor" id="d4e8-3300-2eda-df8f" hidden="false" targetId="fe28-c924-099d-aa4e" type="rule"/>
        <infoLink name="Viento del Caos" id="acce-dc73-f55e-d538" hidden="false" type="profile" targetId="3c21-76a2-2a4b-b5e2"/>
        <infoLink name="Putrefacción de Nurgle (solo Nurgle)" id="fb80-cadd-c2c0-be61" hidden="false" type="profile" targetId="02a8-0f73-9f48-fd79"/>
        <infoLink name="Granadas de Plaga" id="d711-ffb6-aadb-f41a" hidden="false" type="profile" targetId="819d-d10f-96d0-c80e"/>
        <infoLink name="Granadas de asalto" id="20d5-aa40-1512-324b" hidden="false" type="infoGroup" targetId="a9de-5c4c-d2c8-6676"/>
        <infoLink name="Typhus" id="ac35-997f-fd7d-87fe" hidden="false" type="profile" targetId="2575-d304-986e-8bf1"/>
      </infoLinks>
      <costs>
        <cost name="Pts" typeId="puntos" value="225"/>
      </costs>
      <entryLinks>
        <entryLink import="true" name="Armadura de Exterminador" hidden="false" id="fc0e-2e73-0f4a-2751" type="selectionEntry" targetId="13e3-4d39-1e99-6cd3"/>
        <entryLink import="true" name="Reliquia Personal" hidden="false" id="1b46-e455-ae31-458e" type="selectionEntry" targetId="171d-7d8a-d399-386d">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="cd62-b95c-77d2-07a6-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cd62-b95c-77d2-07a6-max" includeChildSelections="false"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <profiles>
        <profile name="Heraldo de Nurgle" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="7b12-efb6-7c6a-176d">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Typhus es un psíquico y cuenta con los poderes Viento del Caos y Putrefacción de Nurgle. Además, Typhus siempre supera sus chequeos psíquicos cuando usa estos dos poderes (y, por tanto, también es inmune a los efectos de los peligros de la disformidad).</characteristic>
          </characteristics>
        </profile>
        <profile name="Enjambre destructor" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="5a97-ddd9-d9f2-2b5f">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El cuerpo de Typhus alberga una plaga horrible que se manifiesta en forma de un enjambre de insectos que escapan por las grietas y huecos de su armadura. Typhus cuenta como si usara granadas de fragmentación y granadas de plaga (consulta la página 38).</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Sacatripas" hidden="false" id="c1d8-f11f-1c3f-1494">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="3baf-707d-16a6-aa9d-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="3baf-707d-16a6-aa9d-max" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Sacatripas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="605d-c5a2-62f5-dda7">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este instrumento letal tiene la forma de una guadaña gigantesca. El Sacatripas es un arma demonio y un arma psíquica. Considera el Sacatripas como un arma demonio normal y, además, cualquier miniatura herida pero no matada por el Sacatripas puede morir si Typhus supera un
chequeo psíquico (sujeto a las reglas habituales de las armas psíquicas). Typhus puede efectuar el chequeo incluso si ha utilizado uno de sus poderes psíquicos en el mismo turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Arma Demonio" id="f52a-a4ff-21c4-cd39" hidden="false" type="infoGroup" targetId="0ccb-c3ab-d1fe-6792"/>
            <infoLink name="Arma Psíquica" id="f5b3-851b-bf70-44f1" hidden="false" type="infoGroup" targetId="3bba-24a9-ee2c-c073"/>
          </infoLinks>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry id="dc77-03b8-e78d-9cf7" name="Huron Blackheart" hidden="false" collective="false" import="true" type="model">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aff3-b288-5dd0-d273" type="max"/>
      </constraints>
      <profiles>
        <profile id="71ee-d5fc-476c-14a6" name="Hamadrya" publicationId="f744-f28b-4145-1729" page="57" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Huron tiene una mascota de naturaleza desconocida a la que él llama su Hamadrya. La bestia parece semi inteligente y permanece al lado de Huron en todo momento, subida en su hombro o escondida tras él si las cosas se ponen muy feas. La criatura nunca lucha o trata de ayudar a
su maestro directamente, pero parece manifestar unos curiosos poderes psíquicos que Huron utiliza en su ventaja.


Hamadrya se considera un familiar, excepto que sus efectos convierten a Huron en un psíquico y le proporciona el poder psíquico Distorsión Temporal.</characteristic>
          </characteristics>
        </profile>
        <profile name="Invulnerable" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="2ad9-d638-15c8-0372" publicationId="f744-f28b-4145-1729" page="57">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Huron tiene una tirada de salvación Invulnerable de 5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Psíquico" id="0042-7568-c460-6715" hidden="false">
          <description>La miniatura se considera Psíquico</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="cdde-2054-b009-4f87" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="f875-335d-f0de-c773" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="Huron" id="1355-be9f-fb34-034f" hidden="false" type="profile" targetId="df82-e71e-0327-261c"/>
        <infoLink name="Granadas Perforantes y de Fragmentación" id="07aa-d6bc-8300-ac18" hidden="false" type="infoGroup" targetId="795b-704d-ab71-04cc"/>
        <infoLink name="Distorsión Temporal" id="03cb-bce8-13de-c1d7" hidden="false" type="profile" targetId="faef-8a27-3911-217e"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="bf0f-ba06-7230-f7eb" name="Garra del Tirano" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="6513-4283-dcf0-b558-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="6513-4283-dcf0-b558-max" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Garra del Tirano" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="3f21-f2c0-39cd-3488" publicationId="f744-f28b-4145-1729" page="57">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La Garra del Tirano es un brazo biónico en forma de garra de oso que fue construido para reemplazar el propio brazo de Huron. La Garra es un puño de combate que lleva incorporado un lanzallamas pesado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Puño de Combate" id="0d2f-32f1-34f4-34ac" hidden="false" type="infoGroup" targetId="25b3-7b9d-199b-6d35"/>
