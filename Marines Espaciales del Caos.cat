      <selectionEntries>
        <selectionEntry name="Látigo del Tormento" id="b629-152f-8bba-856b" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="88bc-f700-4ced-ea5c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="fca5-49d4-3a4e-8cfb" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Látigo del Tormento" id="19d1-39ee-9e57-d9a4" hidden="false" page="53" publicationId="f744-f28b-4145-1729" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este retorcido látigo del Caos se considera un arma de combate cuerpo a cuerpo y además, reduce en 1 los Ataques de cualquier miniatura que
este en contacto peana con peana con la de Lucius (hasta un mínimo de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de las Almas Aullantes" id="6df7-4246-ba0f-a1a7" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f295-2a54-7b28-b05a-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="f295-2a54-7b28-b05a-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Armadura de las Almas Aullantes" id="06c8-0c37-78e7-93ae" hidden="false" page="54" publicationId="f744-f28b-4145-1729" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cada tirada de salvación por armadura o invulnerable que Lucius supere en combate cuerpo a cuerpo causará un impacto de Fuerza 4 sin posibilidad de tirada de salvación por armadura a la unidad que trataba de causarle la herida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
