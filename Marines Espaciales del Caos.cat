      <profiles>
        <profile name="Carentes de inteligencia" id="b2ab-5b63-8113-380e" hidden="false" page="33" publicationId="f744-f28b-4145-1729" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Las unidades de engendros del Caos siempre se mueven el máximo de su capacidad hacia el enemigo más cercano. Siempre intentarán asaltar al enemigo más próximo. En combate cuerpo a cuerpo, cada engendro tiene 1D6 Ataques (tira cada vez que ataquen). Las unidades de engendros del Caos nunca cuentan como unidades que puntúan.</characteristic>
          </characteristics>
        </profile>
      </profiles>
