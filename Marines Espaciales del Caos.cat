      <selectionEntries>
        <selectionEntry id="3f25-6107-841a-816a" name="Báculo Negro de Ahriman" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="e78a-276b-2e6d-6b17" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="4084-465e-7f0e-a056" includeChildSelections="false"/>
          </constraints>
          <profiles>
            <profile name="Báculo Negro de Ahriman" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="5f3a-60bd-bc65-dbbd" publicationId="f744-f28b-4145-1729" page="51">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El Báculo Negro de Ahriman es un arma psíquica que le permite efectuar hasta un máximo de tres chequeos psíquicos en un mismo turno (uno de ellos puede hacerlo para usar la habilidad especial de su arma psíquica). Esto incluso le permite usar varios poderes que cuentan como disparar un arma en la misma fase de disparo (sin embargo, solo puede usarlos sobre una única unidad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink name="Arma Psíquica" id="470b-c548-3f32-050d" hidden="false" type="infoGroup" targetId="3bba-24a9-ee2c-c073"/>
          </infoLinks>
          <costs>
            <cost name="Pts" typeId="puntos" value="0"/>
          </costs>
        </selectionEntry>
