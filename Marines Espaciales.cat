    <selectionEntry id="59b2-7946-4db0-d021" name="Señor del Capítulo Pedro Kántor" publicationId="f176-f140-74d8-da7d" page="90" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a211-c4c4-9bbf-bb09" type="max"/>
