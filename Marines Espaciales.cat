          <profiles>
            <profile name="Lanza de Vulkan" id="00a8-863f-c5ef-882d" hidden="false" page="93" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Es un arma reliquia de precisión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Doctrina de combate" id="2908-19f4-bf5d-3d13" hidden="false">
          <infoLinks>
            <infoLink name="Acoplada" id="1725-4b9b-16bc-f677" hidden="false" targetId="a06f-e29d-bcf4-ed75" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Doctrina de combate" id="09ea-6732-a135-d251" hidden="false" page="93" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a He&apos;stan, todas las unidades de tu ejército pierden la regla especial tácticas de combate. En lugar de ella, todos los martillos de trueno de tu ejército se consideran armas de precisión, y todos los lanzallamas, lanzallamas pesados, rifles de fusion y canones de fusion se consideran armas acopladas. Si más de un personaje de tu
ejército está sujeto a la regla especial doctrina de combate, debes elegir qué versión aplicar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
