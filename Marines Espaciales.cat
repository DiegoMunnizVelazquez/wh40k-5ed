      <profiles>
        <profile id="1856-12e8-552e-a86e" name="Martillo Sísmico" publicationId="f176-f140-74d8-da7d" page="65" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un martillo sismico se considera un arma de combate cuerpo a cuerpo para dreadnoughts que suma +1 al resultado en la Tabla de Daños en Vehículos.</characteristic>
          </characteristics>
        </profile>
