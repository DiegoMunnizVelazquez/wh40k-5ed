        <infoLink name="Granadas Perforantes y de Fragmentación" id="51bb-2736-b43a-910a" hidden="false" targetId="795b-704d-ab71-04cc" type="infoGroup"/>
        <infoLink name="Pistola Bolter" id="ae3a-ee26-049f-cf15" hidden="false" targetId="a787-9bbc-4ee1-e81f" type="infoGroup"/>
        <infoLink name="Aura de Hierro" id="da4e-9ed1-4f55-9fad" hidden="false" targetId="348b-da15-cc84-c027" type="profile"/>
