            <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoGroups>
        <infoGroup id="c565-8fa8-6a7a-8721" name="Maestro Cazador" hidden="false">
          <profiles>
            <profile id="83cd-c6a0-eda1-c1e8" name="Maestro Cazador" publicationId="f176-f140-74d8-da7d" page="94" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Kor&apos;sarro Khan, y las miniaturas de su unidad, se benefician de las reglas especiales atacar y huir y asalto rabioso (consulta el reglamento de Warhammer 40,000).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5609-be56-3e61-b635" name="Atacar y Huir" hidden="false" targetId="e664-80ee-cd50-fd59" type="rule"/>
            <infoLink id="8f4c-c0c4-161d-e62c" name="Asalto Rabioso" hidden="false" targetId="33b4-1a73-92db-e562" type="rule"/>
          </infoLinks>
        </infoGroup>
        <infoGroup id="38dd-bc44-fd59-d099" name="Colmillo Lunar" hidden="false">
          <profiles>
            <profile id="9b0c-fbc0-ac9a-f9f7" name="Colmillo Lunar" publicationId="f176-f140-74d8-da7d" page="94" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de una espada de energia ancestral y una reliquia del capitulo. Las tiradas para herir en las que Kor&apos;sarro obtenga un resultado de 6 causan muerte instantánea, independientemente de la Resistencia del objetivo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="822e-b10f-e332-9495" name="Armas Reliquia" hidden="false" targetId="bd2d-d88a-cac3-8257" type="infoGroup"/>
          </infoLinks>
        </infoGroup>
        <infoGroup id="ba3e-f1c5-9073-1d47" name="Doctrina de combate" hidden="false">
          <profiles>
            <profile id="ed9f-0203-7324-c910" name="Doctrina de combate" publicationId="f176-f140-74d8-da7d" page="93" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a Kor&apos;sarro Khan, todas las unidades de tu ejército sustituyen la regla especial tácticas de combate por la habilidad flanquear. Si eliges esta opción, todos los transportes asignados tambien se benefician de la habilidad flanquear (consulta la regla especial de misión reservas). Si más de un personaje de tu ejército está sujeto a la regla especial doctrina de combate, debes decidir cuál aplicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="b5aa-9f6a-b9e9-6ef5" name="Flanquear" hidden="false" targetId="8870-5967-3fc8-f95d" type="rule"/>
          </infoLinks>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink id="c48a-edfb-f9b0-860f" name="Y no conocerán el miedo" hidden="false" targetId="5ce7-70c4-4a99-db0d" type="rule"/>
        <infoLink id="68ef-e561-cd8c-5b1f" name="Tácticas de Combate" hidden="false" targetId="8bf6-d84e-9cda-1b19" type="rule"/>
        <infoLink id="13ad-0193-688a-9124" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink id="51bb-2736-b43a-910a" name="Granadas Perforantes y de Fragmentación" hidden="false" targetId="795b-704d-ab71-04cc" type="infoGroup"/>
        <infoLink id="ae3a-ee26-049f-cf15" name="Pistola Bolter" hidden="false" targetId="a787-9bbc-4ee1-e81f" type="infoGroup"/>
        <infoLink id="da4e-9ed1-4f55-9fad" name="Aura de Hierro" hidden="false" targetId="348b-da15-cc84-c027" type="profile"/>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="6384-c9d2-6a2d-307f" name="Drakkan Lunar" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="87f0-7e8c-76d7-33ff" type="max"/>
          </constraints>
          <infoGroups>
            <infoGroup id="583e-143b-dfc6-ca56" name="Drakkan Lunar" hidden="false">
              <profiles>
                <profile id="e78a-91fd-eb0b-1422" name="Drakkan Lunar" publicationId="f176-f140-74d8-da7d" page="94" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
                  <characteristics>
                    <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La motocicleta Drakkan Lunar se encargó originalmente para el cuarto Maestro Cazador. Se trata de una motocicleta de los marines espaciales (para detalles, consulta
la pag.100). Si Kor&apos;sarro Khan va montado en Drakkan Lunar, podrá correr en la fase de disparo y, además, estará sujeto a la regla especial veloces (para detalles, consulta el reglamento).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="8491-6e67-d674-2a7a" name="Veloces" hidden="false" targetId="d110-fc1c-250c-54d4" type="rule"/>
              </infoLinks>
            </infoGroup>
          </infoGroups>
          <costs>
            <cost name="Pts" typeId="puntos" value="45"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
      <costs>
        <cost name="Pts" typeId="puntos" value="160"/>
      </costs>
    </selectionEntry>
