          <profiles>
            <profile id="6a80-744c-01e9-6774" name="Estandarte de la Compañía" publicationId="f176-f140-74d8-da7d" page="55" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cualquier unidad marine espacial a 30 cm o menos del portaestandarte siempre repite los chequeos de moral y chequeos de acobardamiento no superados. Además, mientras el portaestandarte siga con vida, la Escuadra de Mando se considera que ha causado una herida adicional en combate cuerpo a cuerpo al cálcular del resultado del asalto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="puntos" value="15"/>
          </costs>
        </selectionEntry>
