              </characteristics>
            </profile>
            <profile id="dfb8-c501-5fd5-f54e" name="Detonación Subterranea" publicationId="f176-f140-74d8-da7d" page="73" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
              <characteristics>
                <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">150cm</characteristic>
                <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
                <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
                <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pesada 4, Área, Temblores</characteristic>
              </characteristics>
            </profile>
            <profile id="f8af-d10e-6b5b-0461" name="Temblores" publicationId="f176-f140-74d8-da7d" page="73" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Una unidad impactada por una detonación subterránea se moverá como si se hallara en terreno dificil en su siguiente fase de movimiento. Si la unidad ya está en terreno dificil, tirará un dado menos de los habituales al determinar su movimiento máximo. Un vehículo afectado por los temblores deberá efectuar un chequeo por terreno peligroso si mueve en su siguiente fase de movimiento. Esto también se
aplica a los gravíticos, cuyos delicados motores gravitatorios se ven dañados por las ondas de choque.</characteristic>
              </characteristics>
            </profile>
            <profile id="747a-e0c1-a8d2-7596" name="Cañón tormenta" publicationId="f176-f140-74d8-da7d" page="73" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Es un arma colosal multicañón. Cada proyectil del cañón puede emplearse para una detonación Superficial, Aérea o Subterránea. Declara el tipo de detonación que vas a utilizar antes de disparar el cañón tormenta.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="Pts" typeId="puntos" value="0"/>
          </costs>
        </selectionEntry>
