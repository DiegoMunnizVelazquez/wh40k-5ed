    <profile name="Sargento Exterminador" id="8933-5bbd-4fd9-2f86" hidden="false" page="64" publicationId="f176-f140-74d8-da7d" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
