    <selectionEntry name="Bibliotecario Marine Espacial" id="475f-181c-69b1-bb38" collective="false" hidden="false" import="true" page="56" publicationId="f176-f140-74d8-da7d" type="unit">
      <costs>
        <cost name="Pts" typeId="puntos" value="100"/>
      </costs>
      <entryLinks>
        <entryLink name="Arma Psíquica" id="695d-f723-a51b-1110" collective="false" hidden="false" import="true" targetId="be4e-94f2-2d2f-cb4f" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Personaje independiente" id="a929-92ec-904b-6c3e" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink name="Tácticas de Combate" id="ef34-3322-f5c2-9a34" hidden="false" targetId="8bf6-d84e-9cda-1b19" type="rule"/>
        <infoLink name="Y no conocerán el miedo" id="485d-064b-ab2b-a11b" hidden="false" targetId="5ce7-70c4-4a99-db0d" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Capucha Psíquica" id="170f-9ff2-a535-74e4" hidden="false" page="56" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Declara que usarás la capucha psíquica después de que una miniatura enemiga a 60 cm o menos del bibliotecario supere un chequeo psíquico. Si hay varios bibliotecarios dentro del alcance, solo uno puede intentar anular el poder psiquico, asi que hay que elegir uno de ellos.

Cada jugador tira 1D6 y añade el atributo de Liderazgo de su miniatura al resultado. Si el Bibliotecario Marine Espacial supera el resultado de la miniatura enemiga, el poder psiquico se anula y no produce efecto ese turno. Si el resultado de la miniatura enemiga es igual o superior, puede usar su poder psiquico normalmente. La capucha psíquica puede usarse cada vez que una miniatura enemiga use un poder psíquico dentro de su alcance.</characteristic>
          </characteristics>
        </profile>
        <profile name="Poderes Psíquicos" id="5111-1152-9714-d32f" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Un Bibliotecario Marine Espacial tiene dos poderes psíquicos (elegidos al organizar el ejercito). Solo puede usar un poder en cada turno del jugador a menos que se haya convertido en un Epistolario, en cuyo caso puede usar hasta dos poderes psíquicos por turno. Todos los poderes psiquicos de los Bibliotecarios Marines Espaciales están sujetos a las reglas descritas en el reglamento de Warhammer 40,000.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bibliotecario" id="9471-392a-9c01-8487" hidden="false" page="56" publicationId="f176-f140-74d8-da7d" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
          <characteristics>
            <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería (Personaje)</characteristic>
            <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
            <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
            <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
            <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic>
