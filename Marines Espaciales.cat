              <profiles>
                <profile id="3132-715c-3685-bdf4" name="Baliza Localizadora" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
                  <characteristics>
                    <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si una unidad entra en el campo de batalla mediante un despliegue rápido, y a 15 cm o menos de una miniatura que transporte una baliza localizadora, no se dispersará. Recuerda que la baliza localizadora debe estar ya situada en el tablero al inicio del turno en el que va a utilizarse.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
