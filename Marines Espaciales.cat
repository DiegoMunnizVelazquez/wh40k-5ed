            <profile name="Detonación Subterranea" id="dfb8-c501-5fd5-f54e" hidden="false" page="73" publicationId="f176-f140-74d8-da7d" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
