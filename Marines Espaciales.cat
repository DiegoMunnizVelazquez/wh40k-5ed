        <profile id="f0b5-ccfd-ff0d-4ffc" name="Manto de Kesar" publicationId="f176-f140-74d8-da7d" page="93" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las escamas de dragon de esta capa son tan duras como el adamantio y proporcionan a He&apos;stan una tirada de salvación invulnerable de 3+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoGroups>
        <infoGroup id="ecff-e7b0-521b-e173" name="Guantelete de la Forja" hidden="false">
          <profiles>
            <profile id="02df-502b-f1af-094b" name="Guantelete de la Forja" publicationId="f176-f140-74d8-da7d" page="93" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Este guantelete blindado puede disparar como un lanzallamas pesado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="6db5-b7ef-ed71-67b2" name="Lanzallamas Pesado" hidden="false" targetId="37a7-0ae8-6e2b-1bb7" type="infoGroup"/>
          </infoLinks>
        </infoGroup>
        <infoGroup id="1b58-5e68-2f47-2e74" name="Lanza de Vulkan" hidden="false">
          <profiles>
            <profile id="00a8-863f-c5ef-882d" name="Lanza de Vulkan" publicationId="f176-f140-74d8-da7d" page="93" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Es un arma reliquia de precisión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e96d-0263-c2f2-ee88" name="Armas de Precisión" hidden="false" targetId="8f62-4549-a7d1-f500" type="profile"/>
            <infoLink id="ef26-c774-7931-efb4" name="Armas Reliquia" hidden="false" targetId="bd2d-d88a-cac3-8257" type="infoGroup"/>
          </infoLinks>
        </infoGroup>
        <infoGroup id="2908-19f4-bf5d-3d13" name="Doctrina de combate" hidden="false">
          <profiles>
            <profile id="09ea-6732-a135-d251" name="Doctrina de combate" publicationId="f176-f140-74d8-da7d" page="93" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a He&apos;stan, todas las unidades de tu ejército pierden la regla especial tácticas de combate. En lugar de ella, todos los martillos de trueno de tu ejército se consideran armas de precisión, y todos los lanzallamas, lanzallamas pesados, rifles de fusion y canones de fusion se consideran armas acopladas. Si más de un personaje de tu
ejército está sujeto a la regla especial doctrina de combate, debes elegir qué versión aplicar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1725-4b9b-16bc-f677" name="Acoplada" hidden="false" targetId="a06f-e29d-bcf4-ed75" type="rule"/>
          </infoLinks>
        </infoGroup>
      </infoGroups>
