    <selectionEntry id="28ff-bd37-a713-b9fb" name="Capitán Cato Sicarius" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ab60-eda4-907f-faec" type="max"/>
      </constraints>
      <profiles>
        <profile id="ea98-f70d-d2a6-7830" name="Ataque Sorpresa" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Un ejercito que incluya a Sicarius puede repetir la tirada de dados para tomar la Iniciativa.</characteristic>
          </characteristics>
        </profile>
        <profile id="212b-ec63-1add-ee80" name="Ritos de Batalla" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los Marines en un ejercito que incluya a Sicarius pueden usar su Liderazgo al efectuar los chequeos de moral o de acobardamiento.</characteristic>
          </characteristics>
        </profile>
        <profile id="8987-a30a-4c0f-8eaa" name="Héroes del Capitulo" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Sicarius va acompanado de los mejores guerreros de la 2a Companía. Una escuadra táctica de un ejército que incluya a Sicarius puede disponer de una de las reglas especiales siguientes sin coste adicional alguno: contraataque, infiltración, explorador o cazacarros.</characteristic>
          </characteristics>
        </profile>
        <profile id="4c14-83bd-4871-119d" name="Espada Tormentosa Talassariana" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de un arma de energía. Si Sicarius quiere, puede intentar un solo ataque de &quot;golpe de gracia&quot; en lugar de sus ataques habituales en combate cuerpo a cuerpo. Si el golpe de gracia impacta, se resuelve con F6 y causa muerte instantánea, independientemente de la Resistencia del objetivo.</characteristic>
          </characteristics>
        </profile>
        <profile id="052a-df33-3e79-6bde" name="Manto de los Suzerain" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de una armadura artesanal que confiere a Sicarius la regla especial ¡No hay dolor!.</characteristic>
          </characteristics>
        </profile>
        <profile id="efda-8ae2-23a4-c702" name="Capitán Cato Sicarius" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
          <characteristics>
            <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería (Personaje)</characteristic>
            <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">6</characteristic>
            <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic>
            <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
            <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
            <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
