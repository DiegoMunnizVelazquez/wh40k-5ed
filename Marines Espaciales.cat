        <profile name="Maestro Psíquico" id="b21a-677a-c8ab-11ab" hidden="false" page="86" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Tigurius conoce todos los poderes psíquicos disponibles para los Bibliotecarios Marines Espaciales.</characteristic>
          </characteristics>
        </profile>
        <profile name="Don de la Presencia" id="f109-028b-b66d-c697" hidden="false" page="86" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si tu ejército incluye a Tigurius, puedes decidir si repites las tiradas de reservas, incluso las superadas.</characteristic>
          </characteristics>
        </profile>
        <profile name="Capucha Infernal" id="e142-c682-b5b3-7f66" hidden="false" page="86" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Funciona como una capucha psíquica y, además, permite que Tigurius use tres poderes psíquicos cada turno.</characteristic>
          </characteristics>
        </profile>
        <profile name="Báculo de Tigurius" id="2ced-9dae-9de3-49e8" hidden="false" page="86" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El Báculo de Tigurius es un arma psíquica de precisión.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bibliotecario Jefe Tigurius" id="70f0-959f-60b4-b20f" hidden="false" page="86" publicationId="f176-f140-74d8-da7d" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
