              <selectionEntries>
                <selectionEntry id="60ae-3934-4136-acd8" name="Estandarte del Capítulo" hidden="false" collective="false" import="true" type="upgrade">
                  <constraints>
                    <constraint field="selections" scope="parent" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0c40-3d2d-83e6-2900" type="max"/>
                    <constraint field="selections" scope="0b72-8a34-5d49-5da1" value="1" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="18ca-71a8-cea4-2143" type="max"/>
                  </constraints>
                  <profiles>
                    <profile id="d49e-0546-b2bc-f20f" name="Estandarte del Capítulo" publicationId="f176-f140-74d8-da7d" page="53" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
                      <characteristics>
                        <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cualquier unidad de marines espaciales a 30 cm o menos del portaestandarte siempre repite los chequeos de moral y los chequeos de acobardamiento no superados. Además, todas las miniaturas de la misma unidad del portaestandarte disponen de +1 Ataque mientras el portaestandarte siga con vida. Mientras el portaestandarte continue vivo, la Guardia de Honor se considera que ha causado una herida adicional en combate cuerpo a cuerpo en el cálculo del resultado del asalto.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                  <costs>
                    <cost name="Pts" typeId="puntos" value="25"/>
                  </costs>
                </selectionEntry>
