    <selectionEntry name="Servidores" id="4c35-1cba-071f-71b4" collective="false" hidden="false" import="true" page="72" publicationId="f176-f140-74d8-da7d" type="unit">
      <constraints>
        <constraint id="f640-d5c3-6732-112b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="0"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="0"/>
      </costs>
      <modifiers>
        <modifier field="f640-d5c3-6732-112b" type="increment" value="1">
          <repeats>
            <repeat childId="1fc2-37c7-602d-d156" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
            <repeat childId="21ad-e0f1-d6bb-6646" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
          </repeats>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Bloqueo mental" id="d084-8475-32bc-2da5" hidden="false" page="72" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Una unidad de Servidores debe efectuar un chequeo por bloqueo mental al inicio de cada turno amigo. Tira 1D6 por cada unidad de Servidores. Si se obtiene un 4-6, superará el chequeo y la unidad podrá actuar normalmente durante el resto del turno. Si el resultado es 1-3, los Servidores han sucumbido a su bloqueo mental y la unidad (y cualquier personaje en la unidad) no podrá mover, disparar o asaltar ese turno (aunque podrán luchar normalmente si están trabados en combate cuerpo a cuerpo). Si la unidad contiene un Tecnomarine o Señor de la Forja al inicio del turno, el chequeo de bloqueo mental se supera automáticamente.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
        <selectionEntryGroup name="Servidor" id="4fb5-d9fa-2307-bb71" collective="false" defaultSelectionEntryId="20c6-b9fc-d861-f91e" hidden="false" import="true">
          <constraints>
            <constraint id="bd89-b666-f94b-5683" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="76cf-78f5-cf09-4e36" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="5"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Servidor con Servobrazo" id="20c6-b9fc-d861-f91e" collective="false" hidden="false" import="true" page="72" publicationId="f176-f140-74d8-da7d" type="model">
              <constraints>
                <constraint id="ec02-f997-2c96-e482" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="5"/>
                <constraint id="eeea-1535-a719-4d10" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
