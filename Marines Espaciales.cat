    <profile id="a189-6d11-fe4e-6e6d" name="Granada Perforante" publicationId="f176-f140-74d8-da7d" page="67" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
