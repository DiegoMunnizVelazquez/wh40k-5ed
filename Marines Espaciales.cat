    <selectionEntry name="La Legión de los Condenados" id="720c-929a-0889-b960" collective="false" hidden="false" import="true" page="95" publicationId="f176-f140-74d8-da7d" type="unit">
      <costs>
        <cost name="Pts" typeId="puntos" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Coraje" id="6b88-7206-6771-27a9" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink name="Avance Sistemático" id="6d92-3ceb-1545-ca14" hidden="false" targetId="bb8e-642b-6fbc-bb61" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Espectros inmortales" id="2dfe-b8ec-506b-f14f" hidden="false" page="95" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La Legión de los Condenados es inmune al armamento más letal. Su tirada de salvación es invulnerable.</characteristic>
          </characteristics>
        </profile>
        <profile name="Ayuda inesperada" id="a14d-1f8e-dbfe-2020" hidden="false" page="95" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La Legión de los Condenados siempreinicia la partida en reserva y siempre se incorporan al juego mediante despliegue rápido, incluso en misiones en que no puede aplicarse esta regla. Recuerda que la Legión de los Condenados es famosa porque aparece donde más se le necesita, así que, si quieres, pueden repetir la tirada para dispersarse en despliegue rápido.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Sargento Condenado" id="1b6b-5ee5-bb45-52a0" collective="false" hidden="false" import="true" type="model">
