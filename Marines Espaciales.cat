    <infoGroup id="1182-441b-2637-4be5" name="Lanzagranadas Auxiliar" hidden="false">
      <profiles>
        <profile id="0e66-17cd-2af2-619f" name="Lanzagranadas Auxiliar" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un lanzagranadas auxiliar puede dispararse además de otra arma. Cada vez que el lanzagranadas auxiliar dispara, el jugador que lo controla debe decidir el tipo de granada utilizado.</characteristic>
          </characteristics>
        </profile>
