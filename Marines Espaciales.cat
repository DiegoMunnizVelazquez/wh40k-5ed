    <selectionEntry id="720c-929a-0889-b960" name="La Legión de los Condenados" publicationId="f176-f140-74d8-da7d" page="95" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="2dfe-b8ec-506b-f14f" name="Espectros inmortales" publicationId="f176-f140-74d8-da7d" page="95" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La Legión de los Condenados es inmune al armamento más letal. Su tirada de salvación es invulnerable.</characteristic>
          </characteristics>
        </profile>
        <profile id="a14d-1f8e-dbfe-2020" name="Ayuda inesperada" publicationId="f176-f140-74d8-da7d" page="95" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La Legión de los Condenados siempreinicia la partida en reserva y siempre se incorporan al juego mediante despliegue rápido, incluso en misiones en que no puede aplicarse esta regla. Recuerda que la Legión de los Condenados es famosa porque aparece donde más se le necesita, así que, si quieres, pueden repetir la tirada para dispersarse en despliegue rápido.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink id="6b88-7206-6771-27a9" name="Coraje" hidden="false" targetId="b23b-fb5c-4c8c-5ae4" type="rule"/>
        <infoLink id="6d92-3ceb-1545-ca14" name="Avance Sistemático" hidden="false" targetId="bb8e-642b-6fbc-bb61" type="rule"/>
