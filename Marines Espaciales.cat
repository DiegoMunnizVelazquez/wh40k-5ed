    <profile id="2ecf-8d26-a519-09f6" name="Motocicleta de Ataque" publicationId="f176-f140-74d8-da7d" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
