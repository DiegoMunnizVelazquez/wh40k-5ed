    <selectionEntry id="1e0e-dc31-f1ae-8b8f" name="Bibliotecario Jefe Tigurius" publicationId="f176-f140-74d8-da7d" page="86" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ab3-2143-d38e-15f1" type="max"/>
      </constraints>
      <profiles>
        <profile id="b21a-677a-c8ab-11ab" name="Maestro Psíquico" publicationId="f176-f140-74d8-da7d" page="86" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Tigurius conoce todos los poderes psíquicos disponibles para los Bibliotecarios Marines Espaciales.</characteristic>
          </characteristics>
        </profile>
        <profile id="f109-028b-b66d-c697" name="Don de la Presencia" publicationId="f176-f140-74d8-da7d" page="86" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si tu ejército incluye a Tigurius, puedes decidir si repites las tiradas de reservas, incluso las superadas.</characteristic>
          </characteristics>
        </profile>
        <profile id="e142-c682-b5b3-7f66" name="Capucha Infernal" publicationId="f176-f140-74d8-da7d" page="86" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Funciona como una capucha psíquica y, además, permite que Tigurius use tres poderes psíquicos cada turno.</characteristic>
          </characteristics>
        </profile>
        <profile id="2ced-9dae-9de3-49e8" name="Báculo de Tigurius" publicationId="f176-f140-74d8-da7d" page="86" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El Báculo de Tigurius es un arma psíquica de precisión.</characteristic>
          </characteristics>
        </profile>
        <profile id="70f0-959f-60b4-b20f" name="Bibliotecario Jefe Tigurius" publicationId="f176-f140-74d8-da7d" page="86" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
          <characteristics>
