        <infoLink name="Granadas Perforantes y de Fragmentación" id="e93e-e37c-ca4a-583b" hidden="false" targetId="795b-704d-ab71-04cc" type="infoGroup"/>
      </infoLinks>
    </infoGroup>
    <infoGroup name="Lanzamisiles Ciclón" id="1d01-dca3-0035-d24d" hidden="false">
      <infoLinks>
        <infoLink name="Lanzamisiles Ciclón" id="f4c6-fb57-64d1-b510" hidden="false" targetId="754b-816e-74aa-4aab" type="profile"/>
        <infoLink name="Lanzamisiles Ciclón Fragmentación" id="fea3-366d-cc99-5c26" hidden="false" targetId="0354-d289-e0b2-5b90" type="profile"/>
        <infoLink name="Lanzamisiles Ciclón Perforante" id="793e-cd4e-182a-8aab" hidden="false" targetId="5a5d-97af-d072-e62c" type="profile"/>
        <infoLink name="Pesada" id="0bc4-c311-269d-f993" hidden="false" targetId="2e56-6b02-4343-0e40" type="rule"/>
        <infoLink name="Área" id="d6b8-d71e-b9ef-5752" hidden="false" targetId="31c7-fe6c-af95-f0b5" type="rule"/>
      </infoLinks>
    </infoGroup>
  </sharedInfoGroups>
  <sharedProfiles>
    <profile name="Armas Digitales" id="7f7f-f8b8-c436-dad3" hidden="false" page="97" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura equipada con armas digitales puede repetir una única tirada para herir no superada en cada fase de asalto</characteristic>
      </characteristics>
    </profile>
    <profile name="Armas de Precisión" id="8f62-4549-a7d1-f500" hidden="false" page="97" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura equipada con armas de precisión puede repetir una única tirada para impactar no superada por turno de jugador al utilizarla.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armas Reliquia" id="cb8e-26ee-644c-deca" hidden="false" page="97" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un arma reliquia se considera un arma de energia, pero sus impactos se resuelven con Fuerza 6. A causa de su tamaño y peso, una miniatura equipada con un arma reliquia no puede conseguir ataques extras por estar equipada con un arma de combate cuerpo a cuerpo adicional.</characteristic>
      </characteristics>
    </profile>
    <profile name="Baliza de Teleportación" id="d14e-d59a-7b95-bcb0" hidden="false" page="100" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si los exterminadores quieren teleportarse al campo de batalla por medio de un despliegue rápido y deciden hacerlo a 15cm o menos de una miniatura equipada con esta baliza, no se dispersarán. Hay que tener en cuenta que la baliza de teleportación únicamente pueden utilizarla unidades que se teleporten; no pueden hacerlo unidades que entren en juego utilizando retrorreactores, capsulas de desembarco u otros medios de transporte. Tambien hay que tener en cuenta que la baliza debe estar sobre el campo de batalla al inicio del turno en que vaya a utilizarse.</characteristic>
      </characteristics>
    </profile>
    <profile name="Capa de Camuflaje" id="d9e3-423a-d9bf-c783" hidden="false" page="100" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Otorga la regla Sigilo a la unidad</characteristic>
      </characteristics>
    </profile>
    <profile name="Munición Infierno" id="8f76-06dc-a401-29fd" hidden="false" page="100" publicationId="f176-f140-74d8-da7d" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">X</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Fuego Rápido, Envenenada (2+)</characteristic>
      </characteristics>
    </profile>
    <profile name="Signum" id="c63b-0def-3619-e6d0" hidden="false" page="101" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura puede utilizar un signum en vez de disparar para que una miniatura de su escuadra actue con HP5 durante el resto de la fase de disparo. Debe declararse que se
va a utilizar el signum antes de resolver ninguna tirada para impactar.</characteristic>
      </characteristics>
    </profile>
    <profile name="Guantaletes de Ultramar" id="248e-1729-77d7-3a52" hidden="false" page="84" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de unos puños de combate con un par de bólters integrados con el siguiente perfil.</characteristic>
      </characteristics>
    </profile>
    <profile name="Guantaletes de Ultramar" id="a10e-0e6e-83e6-d4ea" hidden="false" page="84" publicationId="f176-f140-74d8-da7d" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 2</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura de Antilochus" id="6dc3-bb97-fb46-ab2e" hidden="false" page="84" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Calgar puede equiparse con esta armadura de exterminador, que incluye una baliza de teleportación.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bombardeo Orbital" id="ebe1-e3d9-22ad-833c" hidden="false" page="52" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un señor del capitulo tiene la autoridad para declarar un bombardeo desde un crucero de ataque. Esta habilidad puede usarse una vez por partida en su fase de disparo, siempre que el Señor del Capitulo no haya movido en la fase de movimiento anterior (aunque puede asaltar mas tarde si el jugador que lo controla lo desea). Declarar un
bombardeo orbital equivale a disparar un arma de proyectiles y utiliza el perfil siguiente:

Recuerda que, si obtienes un resultado de flecha en la tirada del dado de dispersión, un bombardeo orbital siempre se tiraran 2D6 para determinar la dispersion, la HP del Senor del Capítulo no supone ninguna diferencia.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bombardeo Orbital" id="e739-bf65-a63f-fad3" hidden="false" page="52" publicationId="f176-f140-74d8-da7d" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Ilimitado</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Artillería 1, Barrera</characteristic>
      </characteristics>
    </profile>
    <profile name="Aura de Hierro" id="348b-da15-cc84-c027" hidden="false" page="52" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Incorpora un campo de energia muy poderoso capaz de desviar incluso los ataques mas peligrosos. Proporciona a su portador una tirada de salvación invulnerable de 4+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Servobrazo" id="8d68-53db-c7e0-0678" hidden="false" page="71" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cada servobrazo garantiza a la miniatura que lo porta un Ataque adicional en combate de Iniciativa 1 y Fuerza 8 que ignora las tiradas de salvación por armadura</characteristic>
      </characteristics>
    </profile>
    <profile name="Desintegración" id="901d-0933-6b60-b442" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="9c33-b0c8-74bd-e5a7" typeName="Poder Psíquico (Proyectil)">
      <characteristics>
        <characteristic name="Alcance" typeId="5bf6-378a-0cb7-b079">30cm</characteristic>
        <characteristic name="F" typeId="12da-9b3e-f37b-bc35">4</characteristic>
        <characteristic name="FP" typeId="10b5-aa5b-ccde-79cc">2</characteristic>
        <characteristic name="Tipo" typeId="20e7-cbcb-1781-a732">Asalto 4</characteristic>
        <characteristic name="Detalles" typeId="a812-390d-dff6-dabd">Este poder es un proyectil psiquico y tiene el perfil siguiente:</characteristic>
      </characteristics>
    </profile>
    <profile name="Cúpula de Fuerza" id="33ad-419e-cd21-7d03" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico">
      <characteristics>
        <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">Unidad</characteristic>
        <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">Este poder se utiliza al inicio de la fase de movimiento del
Bibliotecario. El Bibliotecario y la unidad en la que se en cuentre obtienen una tirada de salvación invulnerable de 5+
hasta el término del siguiente turno del jugador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Maldición de la Máquina" id="eb55-027c-d5df-8270" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico">
      <characteristics>
        <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">60cm, Vehículos</characteristic>
        <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">Este poder es un proyectil psiquico con un alcance de 60 cm que solo afecta a los vehículos. Si la Maldición de la Máquina impacta, el vehiculo sufre un impacto superficial.</characteristic>
      </characteristics>
    </profile>
    <profile name="El Vengador" id="1a64-a8af-7bdf-90de" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="9c33-b0c8-74bd-e5a7" typeName="Poder Psíquico (Proyectil)">
      <characteristics>
        <characteristic name="Alcance" typeId="5bf6-378a-0cb7-b079">Plantilla</characteristic>
        <characteristic name="F" typeId="12da-9b3e-f37b-bc35">5</characteristic>
        <characteristic name="FP" typeId="10b5-aa5b-ccde-79cc">3</characteristic>
        <characteristic name="Tipo" typeId="20e7-cbcb-1781-a732">Asalto 1</characteristic>
        <characteristic name="Detalles" typeId="a812-390d-dff6-dabd">Este poder es un proyectil psiquico y tiene el perfil siguiente:</characteristic>
      </characteristics>
    </profile>
    <profile name="Zona de Anulación" id="2936-75df-59b1-edf6" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico">
      <characteristics>
        <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">60cm, Radio</characteristic>
        <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">Este poder se usa al inicio de la fase de disparo del Bibliotecario. Todas las unidades enemigas a 60 cm o menos del Bibliotecario deben repetir las tiradas de salvación invulnerables superadas durante el resto del turno del jugador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Movimiento Acelerado" id="1616-d4ad-c734-5138" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico">
      <characteristics>
        <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">Propio</characteristic>
        <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">El poder se utiliza al inicio de la fase de asalto del Bibliotecario. Si tiene exito, el Bibliotecario queda sujeto a la regla especial veloces y tiene Iniciativa 10 durante el resto de la
fase de asalto.</characteristic>
      </characteristics>
    </profile>
    <profile name="Poder de los Antiguos" id="35ff-843c-05eb-154a" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico">
      <characteristics>
        <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">Propio</characteristic>
        <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">El poder se utiliza al inicio de la fase de asalto del Bibliotecario. Si se activa, el Bibliotecario tendrá Fuerza 6 y tirará 2D6 para determinar la penetración del blindaje durante el resto
de esa fase de asalto.</characteristic>
      </characteristics>
    </profile>
    <profile name="Puerta al Infinito" id="9b8e-0942-f5f1-a2e1" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="ae70-4738-0161-bec0" typeName="Poder Psíquico">
      <characteristics>
        <characteristic name="Alcance" typeId="fd64-cbc4-94de-24cc">Unidad</characteristic>
        <characteristic name="Detalles" typeId="ad96-dfa4-b4ed-656d">Este poder se utiliza al inicio de la fase de movimiento del Bibliotecario. El Bibliotecario, y la unidad en la que se encuentre, se retiran del tablero e inmediatamente se vuelven a
situar en cualquier punto a una distancia máxima de 60 cm siguiendo las reglas de despliegue rápido. Si el Bibliotecario viaja solo, no ocurre nada; pero, si la unidad se desplaza con el, hay una probabilidad de que algo vaya mal. Si se obtiene un resultado de dobles en la tirada de despliegue rápido, un componente de la unidad (a elección del jugador que la controla) queda atrapado en la disformidad y se retira como baja; el resto de supervivientes se dispersan normalmente.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vórtice de Muerte" id="cf11-bc3c-f234-c5cb" hidden="false" page="57" publicationId="f176-f140-74d8-da7d" typeId="9c33-b0c8-74bd-e5a7" typeName="Poder Psíquico (Proyectil)">
      <characteristics>
        <characteristic name="Alcance" typeId="5bf6-378a-0cb7-b079">30cm</characteristic>
        <characteristic name="F" typeId="12da-9b3e-f37b-bc35">10</characteristic>
        <characteristic name="FP" typeId="10b5-aa5b-ccde-79cc">1</characteristic>
        <characteristic name="Tipo" typeId="20e7-cbcb-1781-a732">Pesada 1, Área</characteristic>
        <characteristic name="Detalles" typeId="a812-390d-dff6-dabd">Si cuando uses este poder el Bibliotecario no supera su chequeo psiquico, sitúa la plantilla de área de efecto del Vórtice de Muerte sobre el Bibliotecario (en este caso, la plantilla no
se dispersará).</characteristic>
      </characteristics>
    </profile>
    <profile name="Honor del Capítulo" id="933b-eeef-e5f5-7a50" hidden="false" page="58" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Un Capellan personifica el honor del capitulo. El Capellán y todos los miembros de la escuadra a la que se ha unido están sujetos a Coraje.</characteristic>
      </characteristics>
    </profile>
    <profile name="Liturgias de Combate" id="7323-1f81-cafc-a43a" hidden="false" page="58" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">En el turno en el que asalta, un Capellán y todos los miembros de la escuadra a la que se ha unido pueden repetir las tiradas para impactar no superadas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rosarius" id="c6fa-de9f-e072-202e" hidden="false" page="58" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Un rosarius es un gorjal o amuleto llevado por los capellanes. Protege al Capellán de todo daño fisico y espiritual. El Rosarius proporciona una tirada de salvación invulnerable de 4+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Crozius Arcanum" id="e9d2-05f5-51d6-8c9f" hidden="false" page="58" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El crozius arcanum es el simbolo del Capellán Marine Espacial. Se trata de un arma de energía.</characteristic>
      </characteristics>
    </profile>
    <profile name="El Puño de Dorn" id="9721-db35-9bdd-2b91" hidden="false" page="91" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de un martillo de trueno de precisión. Todos los impactos producidos con él se resuelven con F10 y suman +1 a la tirada en la Tabla de Daños en Vehiculos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Reforzar las defensas" id="de7d-f46b-1217-6bf1" hidden="false" page="71" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La miniatura puede reforzar una ruina antes de que comience la partida. Cuando despliegues, designa una ruina en tu área de despliegue. La tirada de Salvación por Cobertura de la ruina mejorará en +1 durante toda la partida. Una ruina solo puede reforzarse una vez.</characteristic>
      </characteristics>
    </profile>
    <profile name="Marine Espacial" id="f4f5-1788-8f05-85f5" hidden="false" page="59" publicationId="f176-f140-74d8-da7d" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
        <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería</characteristic>
        <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic>
        <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
        <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
        <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
        <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">1</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic>
        <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
        <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic>
      </characteristics>
    </profile>
