    <profile name="Granada Perforante" id="a189-6d11-fe4e-6e6d" hidden="false" page="67" publicationId="f176-f140-74d8-da7d" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
