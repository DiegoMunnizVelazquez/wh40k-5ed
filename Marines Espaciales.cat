    <selectionEntry name="Kor&apos;sarro Khan" id="1a37-8c5f-ab55-4622" collective="false" hidden="false" import="true" page="85" publicationId="f176-f140-74d8-da7d" type="unit">
      <constraints>
        <constraint id="c4e9-34c6-41c2-83c0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="160"/>
      </costs>
      <infoGroups>
        <infoGroup name="Maestro Cazador" id="c565-8fa8-6a7a-8721" hidden="false">
          <infoLinks>
            <infoLink name="Atacar y Huir" id="5609-be56-3e61-b635" hidden="false" targetId="e664-80ee-cd50-fd59" type="rule"/>
            <infoLink name="Asalto Rabioso" id="8f4c-c0c4-161d-e62c" hidden="false" targetId="33b4-1a73-92db-e562" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Maestro Cazador" id="83cd-c6a0-eda1-c1e8" hidden="false" page="94" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Kor&apos;sarro Khan, y las miniaturas de su unidad, se benefician de las reglas especiales atacar y huir y asalto rabioso (consulta el reglamento de Warhammer 40,000).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Colmillo Lunar" id="38dd-bc44-fd59-d099" hidden="false">
          <infoLinks>
            <infoLink name="Armas Reliquia" id="822e-b10f-e332-9495" hidden="false" targetId="bd2d-d88a-cac3-8257" type="infoGroup"/>
          </infoLinks>
          <profiles>
            <profile name="Colmillo Lunar" id="9b0c-fbc0-ac9a-f9f7" hidden="false" page="94" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
              <characteristics>
                <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Se trata de una espada de energia ancestral y una reliquia del capitulo. Las tiradas para herir en las que Kor&apos;sarro obtenga un resultado de 6 causan muerte instantánea, independientemente de la Resistencia del objetivo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Doctrina de combate" id="ba3e-f1c5-9073-1d47" hidden="false">
          <infoLinks>
            <infoLink name="Flanquear" id="b5aa-9f6a-b9e9-6ef5" hidden="false" targetId="8870-5967-3fc8-f95d" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Doctrina de combate" id="ed9f-0203-7324-c910" hidden="false" page="93" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
              <characteristics>
                <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a Kor&apos;sarro Khan, todas las unidades de tu ejército sustituyen la regla especial tácticas de combate por la habilidad flanquear. Si eliges esta opción, todos los transportes asignados tambien se benefician de la habilidad flanquear (consulta la regla especial de misión reservas). Si más de un personaje de tu ejército está sujeto a la regla especial doctrina de combate, debes decidir cuál aplicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Y no conocerán el miedo" id="c48a-edfb-f9b0-860f" hidden="false" targetId="5ce7-70c4-4a99-db0d" type="rule"/>
        <infoLink name="Tácticas de Combate" id="68ef-e561-cd8c-5b1f" hidden="false" targetId="8bf6-d84e-9cda-1b19" type="rule"/>
