        </profile>
        <profile name="¡Mantened la Linea!" id="3fb5-aeba-4354-51d1" hidden="false" page="90" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si tu ejército incluye a Pedro Kántor, tus Escuadras de Veteranos de la Guardia son unidades que puntúan.</characteristic>
          </characteristics>
        </profile>
        <profile name="Presencia Inspiradora" id="f55d-d128-75b9-30e5" hidden="false" page="90" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Todas las unidades amigas a 30 cm o menos de Pedro Kantor obtienen +1 Ataque mientras Kantor siga con vida. Este bonificador no se aplica a Kántor, y tampoco se acumula al bonificador similar que proporciona el estandarte del capítulo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Doctrina de combate" id="1847-edf6-9ff2-1e7c" hidden="false" page="90" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228"/>
