    <selectionEntry name="Capitán Darnath Lysander" id="5450-80ec-b5e9-8425" collective="false" hidden="false" import="true" page="85" publicationId="f176-f140-74d8-da7d" type="unit">
      <constraints>
        <constraint id="9a7e-a4df-607c-209e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Pts" typeId="puntos" value="200"/>
      </costs>
      <entryLinks>
        <entryLink name="Armadura de Exterminador" id="7774-64eb-751b-7721" collective="false" hidden="false" import="true" targetId="13e3-4d39-1e99-6cd3" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Y no conocerán el miedo" id="76ac-eee4-f364-74d7" hidden="false" targetId="5ce7-70c4-4a99-db0d" type="rule"/>
        <infoLink name="Tácticas de Combate" id="d0e4-e44a-d2cb-bb8d" hidden="false" targetId="8bf6-d84e-9cda-1b19" type="rule"/>
        <infoLink name="Personaje independiente" id="fd91-311f-0f24-3d0c" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
        <infoLink name="Guerrero Eterno" id="185e-094c-6c8a-936a" hidden="false" targetId="71c3-7c34-f6f0-b284" type="rule"/>
        <infoLink name="El puño de Dorn" id="1020-ac0f-04c8-576e" hidden="false" targetId="6a7a-a310-c7ec-5b9f" type="infoGroup"/>
        <infoLink name="Reforzar las defensas" id="35a3-53c1-a99f-c650" hidden="false" targetId="de7d-f46b-1217-6bf1" type="profile"/>
        <infoLink name="Escudo de Tormenta" id="9308-1c62-9ddc-2f2f" hidden="false" targetId="d95f-e2d7-fdfe-87d9" type="profile"/>
      </infoLinks>
      <profiles>
        <profile name="Doctrina de combate" id="8e0b-16f6-6fcb-186c" hidden="false" page="91" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a Lysander, todas las unidades de tu ejército cambian la regla especial tácticas de combate por la regla especial universal testarudos. Si más de un personaje de tu ejército está sujeto a la regla especial doctrina de combate, debes elegir qué versión aplicas.</characteristic>
          </characteristics>
        </profile>
        <profile name="Entrenamiento con el bolter" id="3814-cd97-685b-5c8c" hidden="false" page="91" publicationId="f176-f140-74d8-da7d" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Lysander nunca ha perdido las habilidades que lo hicieron el sargento de escuadra más famoso que los Puños Imperiales hayan tenido. Cualquier miniatura de una escuadra a la que Lysander se haya unido puede repetir las tiradas para impactar no superadas cuando dispare con bólteres pesados, bólteres de asalto, bólteres y pistolas bólter.</characteristic>
          </characteristics>
        </profile>
        <profile name="Capitán Darnath Lysander" id="f17e-8324-4337-0478" hidden="false" page="91" publicationId="f176-f140-74d8-da7d" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
          <characteristics>
            <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería (Personaje)</characteristic>
