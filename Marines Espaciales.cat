        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pesada 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Marine Espacial Veterano" id="e009-66b6-77c3-9754" hidden="false" page="59" publicationId="f176-f140-74d8-da7d" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
