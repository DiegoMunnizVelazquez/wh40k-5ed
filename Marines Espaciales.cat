                      <characteristics>
                        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El disparo de un rayo de conversión tiene un perfil diferente dependiendo de la distancia a la que esté el objetivo. Cuando dispares el rayo de conversión, mide la distancia hasta el objetivo y coloca sobre él la plantilla de área. Una vez situada la localización final del rayo (tras determinar su dispersión), mide desde el centro de la plantilla y consulta la tabla inferior para determinar el efecto:</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="1 - Rayo de Conversión - Hasta 45cm" id="6232-03d6-fea2-0af8" hidden="false" page="70" publicationId="f176-f140-74d8-da7d" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma">
