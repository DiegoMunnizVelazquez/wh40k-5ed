          <characteristics>
            <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
            <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
            <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 4</characteristic>
          </characteristics>
        </profile>
        <profile id="3fb5-aeba-4354-51d1" name="¡Mantened la Linea!" publicationId="f176-f140-74d8-da7d" page="90" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si tu ejército incluye a Pedro Kántor, tus Escuadras de Veteranos de la Guardia son unidades que puntúan.</characteristic>
          </characteristics>
        </profile>
        <profile id="f55d-d128-75b9-30e5" name="Presencia Inspiradora" publicationId="f176-f140-74d8-da7d" page="90" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Todas las unidades amigas a 30 cm o menos de Pedro Kantor obtienen +1 Ataque mientras Kantor siga con vida. Este bonificador no se aplica a Kántor, y tampoco se acumula al bonificador similar que proporciona el estandarte del capítulo.</characteristic>
          </characteristics>
        </profile>
        <profile id="1847-edf6-9ff2-1e7c" name="Doctrina de combate" publicationId="f176-f140-74d8-da7d" page="90" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripcción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228"/>
          </characteristics>
        </profile>
        <profile id="cb9c-1b31-fdc6-66fc" name="Señor del Capítulo Pedro Kántor" publicationId="f176-f140-74d8-da7d" page="90" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
