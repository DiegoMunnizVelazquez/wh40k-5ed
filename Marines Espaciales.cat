      <selectionEntries>
        <selectionEntry name="Drakkan Lunar" id="6384-c9d2-6a2d-307f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="87f0-7e8c-76d7-33ff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Pts" typeId="puntos" value="45"/>
          </costs>
          <infoGroups>
            <infoGroup name="Drakkan Lunar" id="583e-143b-dfc6-ca56" hidden="false">
              <infoLinks>
                <infoLink name="Veloces" id="8491-6e67-d674-2a7a" hidden="false" targetId="d110-fc1c-250c-54d4" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Drakkan Lunar" id="e78a-91fd-eb0b-1422" hidden="false" page="94" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
                  <characteristics>
                    <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">La motocicleta Drakkan Lunar se encargó originalmente para el cuarto Maestro Cazador. Se trata de una motocicleta de los marines espaciales (para detalles, consulta
la pag.100). Si Kor&apos;sarro Khan va montado en Drakkan Lunar, podrá correr en la fase de disparo y, además, estará sujeto a la regla especial veloces (para detalles, consulta el reglamento).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </infoGroup>
          </infoGroups>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
