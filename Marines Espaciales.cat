    <selectionEntry id="12f4-b273-09cf-b2d4" name="Marneus Calgar, Señor de Macragge" publicationId="f176-f140-74d8-da7d" page="84" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ee64-898e-d831-1d5b" type="max"/>
      </constraints>
      <rules>
        <rule id="19b3-7fae-d858-594c" name="Poder Titánico" publicationId="f176-f140-74d8-da7d" page="84" hidden="false">
          <description>Marneus Calgar puede repitir todas las tiradas para Herir fallidas en disparo y en combate cuerpo a cuerpo.</description>
        </rule>
        <rule id="fd20-62b0-8259-4980" name="Dios de la Guerra" publicationId="f176-f140-74d8-da7d" page="84" hidden="false">
          <description>Marneus Calgar puede decidir si supera o no cualquier chequeo de moral que deba efectuar: Mientras Calgar esté en mesa, todas las unidades sujetas a la regla Tacticas de Combate pueden elegir si superan o no sus chequeos de moral.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="5ea5-8970-7d80-bd93" name="Y no conocerán el miedo" hidden="false" targetId="5ce7-70c4-4a99-db0d" type="rule"/>
        <infoLink id="960e-7bd9-4bec-8c18" name="Tácticas de Combate" hidden="false" targetId="8bf6-d84e-9cda-1b19" type="rule"/>
        <infoLink id="144e-4edc-b855-5429" name="Personaje independiente" hidden="false" targetId="61b4-c5bb-9d85-8506" type="rule"/>
