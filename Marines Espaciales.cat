    <selectionEntry id="5450-80ec-b5e9-8425" name="Capitán Darnath Lysander" publicationId="f176-f140-74d8-da7d" page="85" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="roster" value="1" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9a7e-a4df-607c-209e" type="max"/>
      </constraints>
      <profiles>
        <profile id="8e0b-16f6-6fcb-186c" name="Doctrina de combate" publicationId="f176-f140-74d8-da7d" page="91" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si incluyes a Lysander, todas las unidades de tu ejército cambian la regla especial tácticas de combate por la regla especial universal testarudos. Si más de un personaje de tu ejército está sujeto a la regla especial doctrina de combate, debes elegir qué versión aplicas.</characteristic>
          </characteristics>
        </profile>
        <profile id="3814-cd97-685b-5c8c" name="Entrenamiento con el bolter" publicationId="f176-f140-74d8-da7d" page="91" hidden="false" typeId="c970-b832-a956-1ac8" typeName="Habilidad">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Lysander nunca ha perdido las habilidades que lo hicieron el sargento de escuadra más famoso que los Puños Imperiales hayan tenido. Cualquier miniatura de una escuadra a la que Lysander se haya unido puede repetir las tiradas para impactar no superadas cuando dispare con bólteres pesados, bólteres de asalto, bólteres y pistolas bólter.</characteristic>
          </characteristics>
        </profile>
        <profile id="f17e-8324-4337-0478" name="Capitán Darnath Lysander" publicationId="f176-f140-74d8-da7d" page="91" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
          <characteristics>
            <characteristic name="Tipo" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantería (Personaje)</characteristic>
            <characteristic name="HA" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">6</characteristic>
            <characteristic name="HP" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic>
            <characteristic name="F" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
            <characteristic name="R" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
            <characteristic name="H" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">4</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="L" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+</characteristic>
          </characteristics>
        </profile>
