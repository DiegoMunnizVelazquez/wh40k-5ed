              <selectionEntries>
                <selectionEntry name="Estandarte del Capítulo" id="60ae-3934-4136-acd8" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="0c40-3d2d-83e6-2900" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="18ca-71a8-cea4-2143" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="0b72-8a34-5d49-5da1" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="Pts" typeId="puntos" value="25"/>
                  </costs>
                  <profiles>
                    <profile name="Estandarte del Capítulo" id="d49e-0546-b2bc-f20f" hidden="false" page="53" publicationId="f176-f140-74d8-da7d" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
                      <characteristics>
                        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cualquier unidad de marines espaciales a 30 cm o menos del portaestandarte siempre repite los chequeos de moral y los chequeos de acobardamiento no superados. Además, todas las miniaturas de la misma unidad del portaestandarte disponen de +1 Ataque mientras el portaestandarte siga con vida. Mientras el portaestandarte continue vivo, la Guardia de Honor se considera que ha causado una herida adicional en combate cuerpo a cuerpo en el cálculo del resultado del asalto.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Arma Relíquia" id="5e28-0910-5d9f-9671" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
