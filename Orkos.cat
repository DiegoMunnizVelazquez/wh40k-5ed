      <profiles>
        <profile name="Reputación asesina" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="1ea9-b780-07e4-408c" publicationId="11a0-7b47-fa28-1d82" page="62">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cuando Snikrot y su unidad ganan un combate, la unidad enemiga sufrirá un modificador de -1 adicional a su Liderazgo.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dientes de Morko" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="eb49-7159-d7a1-b06d" publicationId="11a0-7b47-fa28-1d82" page="62">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Snikrot cuenta con un ataque adicional en combate cuerpo a cuerpo, adicionalmente podrá repetir todas las tiradas para impactar fallidas en combate.</characteristic>
          </characteristics>
        </profile>
        <profile name="Emboscada" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="5daa-9e6c-b9d4-0f94" publicationId="11a0-7b47-fa28-1d82" page="62">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Snikrot y su unidad pueden empezar la partida en reserva, cuando la unidad esté disponible podrá entrar por cualquier borde del tablero.</characteristic>
          </characteristics>
        </profile>
      </profiles>
