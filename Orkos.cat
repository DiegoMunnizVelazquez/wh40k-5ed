    <infoGroup name="Viejo Zogwort" id="9c97bbd3-f54a-489f-9d8a-9590e1c2eae5" hidden="false">
      <infoLinks>
        <infoLink name="Viejo Zogwort" type="profile" targetId="a715-22c3-c837-80dd" id="fa8fea60-7f7e-4006-9d18-fe7f4b5d0424" hidden="false"/>
        <infoLink name="¡La Peña triunfará!" id="c754-03f1-43c3-9118" hidden="false" type="rule" targetId="5e0f-344d-a5bb-fbdc"/>
        <infoLink name="¡Waaagh!" id="f1ba-461a-325b-64d1" hidden="false" type="rule" targetId="42e1-f7fd-5e72-83fa"/>
