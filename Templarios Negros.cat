    <selectionEntry type="upgrade" import="true" name="Cañón automático" hidden="false" id="f9bcae83-abaf-4c46-92bc-d369b6e15e1a">
      <infoLinks>
        <infoLink name="Cañón Automático" id="a4d9b092-ceb7-4ba1-88b7-7ebb6f95d18a" hidden="false" targetId="33e3-aa73-1b0e-2e83" type="profile"/>
      </infoLinks>
    </selectionEntry>
