      </characteristics>
    </profile>
    <profile name="Neófito de la escolta de Helbrecht" id="072059a5-c90f-487a-8e68-c17b192a84fe" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
