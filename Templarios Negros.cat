        <characteristic name="S" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+</characteristic>
      </characteristics>
    </profile>
    <profile name="Capellán Grimaldus" id="b2c35ca8-c510-47e9-b67e-96d2347a58dc" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unidad">
      <characteristics>
