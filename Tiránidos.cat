        <infoLink name="Campo disforme" id="fc90-d4a9-9dd5-a855" hidden="false" type="profile" targetId="6622-3596-f6bb-091d"/>
        <infoLink name="Asalto" id="eca5-c374-4537-d814" hidden="false" type="rule" targetId="8714-46ad-62c0-ce35"/>
        <infoLink name="Área Grande" id="5d78-854a-83f4-7e77" hidden="false" type="rule" targetId="952e-d8aa-7560-44b9"/>
      </infoLinks>
      <entryLinks>
        <entryLink import="true" name="Espora micética" hidden="false" id="905a-3740-e041-526c" type="selectionEntry" targetId="c059-7987-8ef4-3a9c">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e65f-cf4b-2393-c3c2"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <profiles>
        <profile name="Absorción espiritual" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="d2e1-653f-e7ce-794b">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Al principio de cada fase de disparo, incluyendo la del enemigo, cada unidad enemiga que no sea un vehículo a 15cm de la Maldición de Malan&apos;tai deberá efectuar un chequeo de Liderazgo con 3D6. Si fallan el chequeo, las unidades sufrirán una herida por cada punto por el que hayan fallado el chequeo, sin posibilidad de tiradas de salvación por armadura.</characteristic>
          </characteristics>
        </profile>
        <profile name="Absorción vital" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="5d86-3b08-a4ea-14d3">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La maldición de Malan&apos;tai gana inmediatamente +1 Herida hasta un máximo de 10 Heridas por cada herida no salvada que haga.</characteristic>
          </characteristics>
        </profile>
        <profile name="Fuerza psíquica" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="b9b7-8f36-9e47-405b">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">La Fuerza de la maldición de Malan&apos;tai es siempre la misma que su atributo de Heridas. Por lo tanto, por cada herida que pierda también verá reducida su Fuerza.</characteristic>
          </characteristics>
        </profile>
        <profile name="Cataclismo" typeId="9c33-b0c8-74bd-e5a7" typeName="Poder Psíquico (Proyectil)" hidden="false" id="985d-adc6-1c24-2fdc">
          <characteristics>
            <characteristic name="Alcance" typeId="5bf6-378a-0cb7-b079">24&quot;</characteristic>
            <characteristic name="F" typeId="12da-9b3e-f37b-bc35">X</characteristic>
            <characteristic name="FP" typeId="10b5-aa5b-ccde-79cc">1</characteristic>
            <characteristic name="Tipo" typeId="20e7-cbcb-1781-a732">Asalto 1, Área grande</characteristic>
            <characteristic name="Detalles" typeId="a812-390d-dff6-dabd">La fuerza del Cataclismo es igual al atributo de heridas que tenga Malan&apos;tai en el momento de utilizarlo.
Después de utilizar el poder, pero antes de ganar heridas por la absorción vital, Malan&apos;tai sufrirá 1D3 heridas. No se le permite ningún tipo de salvación.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="fb93-d7f6-f387-7756" includeChildSelections="true"/>
      </constraints>
    </selectionEntry>
