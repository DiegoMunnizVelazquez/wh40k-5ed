      <profiles>
        <profile name="Rapid Regeneration" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="6324-4b41-0e7c-6657">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">At the start of your turn, as long as Old One Eye is still alive, roll a D6 for each Wound lost: for every 5 or 6 rolled, Old One Eye recovers a single lost Wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Berserk Rampage" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="69a2-0358-3617-3e32">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">For every successful To Hit roll that Old One Eye makes in close combat, it may immediately make one additional Attack against the same unit. These additional Attacks do not confer any extra Attacks if they also hit the enemy.</characteristic>
          </characteristics>
        </profile>
        <profile name="Alpha Leader" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="777e-57c5-efac-59db">
          <characteristics>
            <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Any friendly units within 12&quot; of Old One Eye may choose to use its Leadership for any Morale or Leadership tests they are required to make.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
