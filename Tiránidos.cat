      </costs>
      <infoLinks>
        <infoLink name="Deathleaper" id="815a-89af-7e48-5ed9" hidden="false" type="profile" targetId="75e9-fd36-3e92-19d1"/>
        <infoLink name="Chameleonic Skin" id="41b0-53db-4a5d-a82a" hidden="false" type="profile" targetId="59fd-1cf3-9413-7912"/>
        <infoLink name="Flesh Hooks" id="d668-d91e-e828-c5ed" hidden="false" type="profile" targetId="29d2-7727-8aaa-e025"/>
        <infoLink name="Garras aceradas" id="28dd-81f2-8cc1-fa43" hidden="false" type="profile" targetId="b14f-e98f-bb94-e63f"/>
