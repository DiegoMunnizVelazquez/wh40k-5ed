    <profile name="Estrangulador" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="00bb-38f3-55ea-96bf">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Plantilla</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">2*</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Acobardamiento, Hieren contra la Fuerza</characteristic>
      </characteristics>
    </profile>
    <profile name="Enjambre pectoral con larvas electrificadas" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="6d68-3102-357f-54a6">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Plantilla</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1</characteristic>
      </characteristics>
      <alias/>
    </profile>
    <profile name="Enjambre pectoral con gusanos secantes" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="4c04-81db-6eb3-090b">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Plantilla</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">1</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Enjambre pectoral con cucarachas espinadas" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="4753-5245-8609-61f9">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Plantilla</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">3</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Acerada</characteristic>
      </characteristics>
    </profile>
    <profile name="Cañón venenoso" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="ceb3-7424-1f03-0ca7">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">90cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Área</characteristic>
      </characteristics>
    </profile>
    <profile name="Espada ósea" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="6c07-f05d-c18a-ee85" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">No se permiten las salvaciones por armadura contra las heridas provocadas en cuerpo a cuerpo por un Tiránido equipado con una Espada ósea. Además, si una miniatura sufre una o más heridas sin salvar provocadas en cuerpo a cuerpo por un Tiránido equipado con una Espada ósea, deberá superar inmediatamente un chequeo de Liderazgo o sufrir muerte instantánea. Si la criatura Tiránida que infligió la herida tiene un par de Espadas óseas, el chequeo de Liderazgo deberá efectuarse con 3D6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Garras y dientes" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="7c9d-9e0a-cc00-defb" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Las miniaturas con garras y dientes se consideran equipadas con armas de cuerpo a cuerpo normales.</characteristic>
      </characteristics>
    </profile>
    <profile name="Garras trituradoras" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="2d7b-ae8e-20dd-559d" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">El Tiránido equipado con Garras trituradoras obtiene 1D3 ataques adicionales en cuerpo a cuerpo (se tiran al principio de cada turno de combate), pero atacará con Iniciativa 1 independientemente cualquier modificador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Látigo orgánico" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="03cb-0385-2167-e4be" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Una miniatura enemiga en contacto peana con peana con un Tiránido con uno o más Látigos orgánicos, convertirá su valor de Iniciativa en un 1 hasta el fin de la fase de Asalto, independientemente de su valor de Iniciativa actual.</characteristic>
      </characteristics>
    </profile>
    <profile name="Garras aceradas" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="b14f-e98f-bb94-e63f" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Los ataques en cuerpo a cuerpo efectuados por las miniaturas con garras aceradas, obtienen la característica Acerados, según se detalla en el reglamento de Warhammer 40,000.</characteristic>
      </characteristics>
    </profile>
    <profile name="Garras afiladas" typeId="cdf6-05fb-71d5-1982" typeName="Arma de combate" hidden="false" id="4142-8bec-e73c-f7b7" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="11b5-56ae-f93d-b524">Una miniatura Tiránida con un único par de Garras afiladas podrá repetir todos los resultados de 1 en sus tiradas para impactar en cuerpo a cuerpo. Una miniatura Tiránida con dos pares de Garras afiladas puede repetir todas las tiradas para impactar en cuerpo a cuerpo fallidas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Exoesqueleto enlazado" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="87b4-00cc-c9cc-9210" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una miniatura con exoesqueleto enlazado tiene una salvación por armadura de 3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Caparazón blindado" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="2209-b050-a79c-fa7f" publicationId="6677-c576-13ff-2bc5" page="83">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Una unidad equipada con un caparazón blindado obtiene una salvación por armadura de 2+</characteristic>
      </characteristics>
    </profile>
    <profile name="Sangre ácida" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="932f-f50f-f25b-029b" publicationId="6677-c576-13ff-2bc5" page="84">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Por cada herida sin salvar que reciba en cuerpo a cuerpo una criatura con Sangre ácida, la unidad enemiga que provocó dicha herida deberá superar un chequeo de Iniciativa o sufrir una herida. No se permiten salvaciones por armadura ni por cobertura contra estas heridas, y las bajas se tendrán en cuenta para la resolución del combate. Los bípodes sufrirán un impacto superficial con un resultado de 4+ en 1D6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mandíbula ácida" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="0b26-f58c-c911-5671" publicationId="6677-c576-13ff-2bc5" page="84">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los ataques cuerpo a cuerpo del portador ignorar las salvaciones por armadura</characteristic>
      </characteristics>
    </profile>
    <profile name="Glándula de adrenalina" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="ba15-539b-8427-fa0b">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas Tiránidas con este biomorfo tienen la regla especial Asalto rabioso, como se indica en el reglamento de Warhammer 40,000.</characteristic>
      </characteristics>
    </profile>
    <profile name="Veneno cegador" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="f0a0-4589-74e6-5c9a">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Contra unidades que no sean vehículos, cualquier resultado de 6 para impactar en combate causará una herida automática.</characteristic>
      </characteristics>
    </profile>
    <profile name="Escamas camaleónicas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="59fd-1cf3-9413-7912">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Los Lictors siempre empiezan la partida en reserva, incluso en misiones donde no se podría. Cuando estén disponibles, los Lictors se pueden colocar en cualquier punto del tablero a 1&quot; de cualquier miniatura enemiga, Los Lictors no pueden asaltar en el turno en el que entran, pero pueden disparar o correr normalmente.</characteristic>
      </characteristics>
    </profile>
    <profile name="Espinas de fragmentación" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="0571-b003-4f15-3a92" publicationId="6677-c576-13ff-2bc5" page="84">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El portador cuenta con granadas de asalto</characteristic>
      </characteristics>
    </profile>
    <profile name="Aguijón" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="5597-556d-1de7-5fa9">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cualquier resultado de 6 en una tirada para herir obtenido por una miniatura con este biomorfo en un ataque cuerpo a cuerpo infligirá Muerte instantánea, independientemente de la Resistencia del oponente.</characteristic>
      </characteristics>
    </profile>
    <profile name="Regeneración" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="e8d9-c24c-0ada-0f4a">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Al principio de tu turno, siempre que la miniatura con este biomorfo continúe con vida, tira 1D6 por cada Herida sufrida. La miniatura recuperará una de las heridas perdidas por cada 6 obtenido en la tirada.</characteristic>
      </characteristics>
    </profile>
    <profile name="Miasma tóxico" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="f0af-7b7b-bae0-b9fe">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Al final del turno de cada jugador, cada miniatura que no sea un vehículo en contacto peana con peana con un Tiránido con este biomorfo deberá superar un chequeo de Resistencia o sufrir una herida. Se pueden hacer salvaciones por armadura -no así por cobertura- de forma normal.</characteristic>
      </characteristics>
    </profile>
    <profile name="Glándulas de toxinas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="bf9b-5f6f-7099-c9e8">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Si un Tiránido cuenta con el biomorfo Glándulas de toxinas, todas sus armas de cuerpo a cuerpo se convierten en armas envenenadas (4+), según se detalla en el reglamento de Warhammer 40,000.</characteristic>
      </characteristics>
    </profile>
    <profile name="Alas" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo" hidden="false" id="4b5c-7fa6-cbb6-81a9">
      <characteristics>
        <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Las miniaturas con alas moverán del mismo modo que las unidades retropropulsadas, según se describe en el reglamento de Warhammer 40,000.</characteristic>
      </characteristics>
    </profile>
    <profile name="Acechar" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="b0d0-ba0f-5b54-513e" publicationId="6677-c576-13ff-2bc5" page="33">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Una unidad que aceche no podrá mover en la fase de Movimiento ni podrá asaltar en la fase de Asalto. En la fase de Disparo, la unidad deberá disparar sobre el enemigo más cercano en su línea de visión. Si no hay enemigos en línea de visión o dentro del alcance de al menos una de sus armas, o si la unidad no tiene armamento a distancia, ésta deberá correr hacia el elemento de escenografía de área más próximo y meterse dentro si es posible. Si la unidad ya se encuentra en un elemento de escenografía de área se quedará en él sin moverse.</characteristic>
      </characteristics>
    </profile>
    <profile name="Alimentarse" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="033b-00cf-e0e1-c66c" publicationId="6677-c576-13ff-2bc5" page="33">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Una unidad que debe alimentarse está sujeta a la regla Rabia, detallada en el reglamento de Warhammer 40,000. Además, la unidad no podrá disparar armas en la fase de Disparo, pero, según la regla Rabia, podrá seguir corriendo normalmente.</characteristic>
      </characteristics>
    </profile>
    <profile name="Criatura sináptica" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="c532-63f6-20dd-0d6f" publicationId="6677-c576-13ff-2bc5" page="33">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Las Criaturas sinápticas y las unidades de Tiránidos que se encuentren a 30cm de una Criatura Sináptica se considerará que están dentro del alcance sináptico. Una unidad dentro del alcance sináptico no se verá sujeta a la regla Conducta Instintiva y obtiene la regla Coraje, detallada en el reglamento de Warhammer 40,000. Si una unidad en retirada se encuentra dentro de alcance sináptico antes de moverse, se reagrupará automáticamente a pesar de las restricciones normales.</characteristic>
      </characteristics>
    </profile>
    <profile name="La sombra de la disformidad" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="90e3-72fc-385a-b619" publicationId="6677-c576-13ff-2bc5" page="33">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Cualquier psíquico enemigo que realice un chequeo psíquico a 30cm de un Tiránido con la regla especial de La Sombra de la Disformidad, deberá hacerlo tirando 3D6 y sufrirá un ataque de Peligros de la Disformidad si obtiene un doble 1 o doble 6.</characteristic>
      </characteristics>
    </profile>
    <profile name="Escupemuerte" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="7fef-72a3-7feb-5273">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 3</characteristic>
      </characteristics>
    </profile>
    <profile name="Devorador acoplado con Sanguijuelas cerebrales" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="c2c8-8387-5e85-1269">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 6, Acoplada</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Área" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="03e2-2b5f-2690-f68e">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Área</characteristic>
      </characteristics>
    </profile>
    <profile name="Warp Lance" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="516b-72ea-d906-7389">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">45cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Lance</characteristic>
      </characteristics>
    </profile>
    <profile name="Rastro de feronomas" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="269d-06e3-8000-220c">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Si hay un Lictor en la mesa al principio de la fase de Movimiento, el jugador tiránido añadirá un +1 a sus tiradas de reservas. Además, si alguna unidad despliega mediante Despliegue rápido, podrá situarse a 15 cm de un Líctor sin dispersarse. Esta habilidad no funcionará si el mismo Lictor ha llegado desde la reserva ese mismo turno.</characteristic>
      </characteristics>
    </profile>
    <profile name="Campo disforme" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="6622-3596-f6bb-091d">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">El campo disforme otorga una salvación invulnerable de 3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Telepatía de progenie" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="4d6c-98fb-0e8b-b1a1">
      <characteristics>
        <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">Los Genestealers no están sujetos a la regla de conducta instintiva</characteristic>
      </characteristics>
    </profile>
    <profile name="Cañón estrangulador acoplado" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="6578-a80d-0865-64e7">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">90cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Área grande, Acobardamiento, Acoplada</characteristic>
      </characteristics>
    </profile>
    <profile name="Cañón venenoso pesado acoplado" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Arma" hidden="false" id="1713-4155-f08d-d8ef">
      <characteristics>
        <characteristic name="Alcance" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">90cm</characteristic>
        <characteristic name="F" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">9</characteristic>
        <characteristic name="FP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Tipo" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Asalto 1, Área, Acoplada</characteristic>
