        <infoLink name="Alimentarse" id="fd4b-4d0e-f9d8-23f5" hidden="false" type="profile" targetId="033b-00cf-e0e1-c66c"/>
      </infoLinks>
      <profiles>
        <profile name="Spore Cloud" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="04f4-9d79-d429-4c8d">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">The Venomthrope and any friendly units within 6&quot; of the unit, can claim a 5+ cover save against any shooting attacks. In addition, these units count as being armed with defensive grenades and any non-vehicle enemy model that Asaltos one of these units must take a dangerous terrain test to represent the toxic effect of the spore cloud. Should the venomthrope be killed, these bonuses are immediately lost.</characteristic>
          </characteristics>
        </profile>
        <profile name="Toxic Touch" typeId="c970-b832-a956-1ac8" typeName="Habilidad" hidden="false" id="1d99-652c-553a-bf44">
          <characteristics>
            <characteristic name="Descripción" typeId="917b-713d-7c3d-7a9e">A Venomthrope&apos;s close combat attacks are Poisoned (2+)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <entryLinks>
