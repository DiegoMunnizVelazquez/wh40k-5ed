            <infoLink name="Criatura sináptica" id="d07e-8bcd-5b7f-97ac" hidden="false" type="profile" targetId="c532-63f6-20dd-0d6f"/>
            <infoLink name="El horror" id="663d-3c6c-5382-3b0f" hidden="false" type="profile" targetId="685e-61c3-0b20-b391"/>
            <infoLink name="El señor de la horda" id="e207-12de-8306-5ad8" hidden="false" type="profile" targetId="fae9-59c3-c0b2-d822"/>
            <infoLink name="La sombra de la disformidad" id="2b6e-f52c-247f-5d76" hidden="false" type="profile" targetId="90e3-72fc-385a-b619"/>
            <infoLink name="Paroxismo" id="648b-60fc-eced-111a" hidden="false" type="profile" targetId="0656-6afb-a3c2-134e"/>
