      </costs>
      <infoLinks>
        <infoLink name="La maldición de Malan&apos;tai" id="ff37-a286-4083-a3b2" hidden="false" type="profile" targetId="463b-78ff-04f9-d748"/>
        <infoLink name="Garras y dientes" id="3514-889d-3923-b73f" hidden="false" type="profile" targetId="7c9d-9e0a-cc00-defb"/>
        <infoLink name="Conducta instintiva alimentarse" id="b179-d02c-19ae-e508" hidden="false" type="infoGroup" targetId="3a72-765b-4e1f-c998"/>
