      </infoLinks>
      <selectionEntryGroups>
        <selectionEntryGroup name="Take any of the following abilities" id="1f19-9ddd-8ba1-609d" hidden="false">
          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Hive Commander" hidden="false" id="7ca0-a3ed-310f-4283">
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25"/>
              </costs>
              <profiles>
                <profile name="Hive Commander" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="69d5-42fa-e58c-75a2">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">If a model has the Hive Commander upgrade, a single unit of Troops may outflank. In addition, whilst the model is alive, you may add +1 to your reserve rolls.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c38e-78fc-554a-8067"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Indescribable Horror" hidden="false" id="99ba-3b33-d7c0-c15c">
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25"/>
              </costs>
              <profiles>
                <profile name="Indescribable Horror" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="0763-f227-201d-a028">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">Units wishing to assault a model with the Indescribable Horror upgrade, or the unit it is with, must first pass a Leadership test. If the test is passed then the unit may assault as normal. If the test is failed then the squad falters and may not launch an assault that turn. This has no effect on enemy units that have the Fearless special rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0a60-a91d-3c11-7d82"/>
              </constraints>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Old Adversary" hidden="false" id="d5b9-1eaa-8471-6a38">
              <costs>
                <cost name="Points" typeId="6f18-a8fc-2c5b-9517" value="25"/>
              </costs>
              <profiles>
                <profile name="Old Adversary" typeId="ccb3-7790-3139-7975" typeName="Abilities" hidden="false" id="fdbb-b259-410f-8fd4">
                  <characteristics>
                    <characteristic name="Description" typeId="e24a-6018-20cf-d76c">All Tyranid units within 6&quot; of a model with the Old Adversary upgrade benefit from the Preferred Enemy special rule. This includes the bearer itself.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="59ae-41f6-d7cf-afde"/>
              </constraints>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Take any of the following" id="dc40-d7b1-d72b-2060" hidden="false">
