    <selectionEntry name="Signum" id="a5e8c73e-116d-4e31-a799-70740972d519" collapsible="true" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Signum" id="9fa20e96-f9ff-4e6e-b893-05eb91ab630a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">El signum es un tipo de herramienta de comunicación especial que puede dar acceso a gran cantidad de datos útiles para apuntar, permitiendo una concentración del fuego más precisa. Una miniatura podrá utilizar un signum en vez de realizar un disparo por su cuenta. Si se opta por utilizarlo, una miniatura de su escuadra obtendrá Habilidad de proyectiles 5 durante esa fase de disparo. Se debe declarar el uso del signum antes de realizar ninguna tirada de disparo.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Escudo de asedio" id="ed65205c-1496-407b-aefe-26eab6de3eac" collapsible="true" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Escudo de asedio" id="ae4a2cf5-1478-46bb-a72b-681921f5bde2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Equipo">
          <characteristics>
            <characteristic name="Descripción" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Muchos Vindicators están equipados con una enorme pala excavadora. Un Vindicator con un escudo de asedio supera automáticamente los chequeos por terreno peligroso.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
